#!wit/toml
author="CLAM"
description="Show git diff"
enabled=true
license="Artistic-2.0"
name="git_diff"
notes="Read-only. Shows changes in working tree.\n"
priority=10
timeout=10
type="rule"
usage="Input: { path: \".\", staged: false }\nOutput: { diff: \"...\", lines_added: 10, lines_removed: 5 }\n"
version="1.0.0"
triggers=[
  "git_diff",
]

[metadata]
category="git"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $path = ref $input eq 'HASH' ? ($input->{path} // '.') : '.';
my $staged = ref $input eq 'HASH' ? ($input->{staged} // 0) : 0;

my $cmd = $staged ? "cd '$path' && git diff --cached" : "cd '$path' && git diff";
my $output = `$cmd 2>/dev/null`;
my $exit = $? >> 8;

return { error => "Not a git repository" } if $exit != 0 && !$output;

my @lines = split /\n/, $output;
my $added = grep { /^\+/ && !/^\+\+\+/ } @lines;
my $removed = grep { /^\-/ && !/^\-\-\-/ } @lines;

return {
    diff         => $output,
    lines_added  => $added,
    lines_removed => $removed,
    staged       => $staged,
    path         => $path,
};

PERL
