#!wit/toml
author="CLAM"
description="Manage .gitignore file"
enabled=true
license="Artistic-2.0"
name="git_ignore"
notes="Lists or adds patterns to .gitignore.\n"
priority=10
timeout=10
type="rule"
usage="Input: { path: \".\", action: \"list\" }\nInput: { path: \".\", action: \"add\", pattern: \"*.log\" }\nOutput: { patterns: [...], added: true }\n"
version="1.0.0"
triggers=[
  "git_ignore",
]

[metadata]
category="git"
complexity="simple"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $path = ref $input eq 'HASH' ? ($input->{path} // '.') : '.';
my $action = ref $input eq 'HASH' ? ($input->{action} // 'list') : 'list';
my $pattern = ref $input eq 'HASH' ? ($input->{pattern} // '') : '';

my $gitignore = "$path/.gitignore";

if ($action eq 'list') {
    return { patterns => [], file => $gitignore } unless -f $gitignore;

    open my $fh, '<', $gitignore or return { error => "Cannot read: $!" };
    my @patterns = grep { /\S/ && !/^\s*#/ } <$fh>;
    close $fh;
    chomp @patterns;

    return {
        patterns => \@patterns,
        count    => scalar @patterns,
        file     => $gitignore,
    };
}

if ($action eq 'add') {
    return { error => "No pattern provided" } unless $pattern;

    # Check if pattern already exists
    if (-f $gitignore) {
        open my $fh, '<', $gitignore;
        my @existing = <$fh>;
        close $fh;
        chomp @existing;
        if (grep { $_ eq $pattern } @existing) {
            return { ok => 1, message => "Pattern already exists" };
        }
    }

    # Append pattern
    open my $fh, '>>', $gitignore or return { error => "Cannot write: $!" };
    print $fh "$pattern\n";
    close $fh;

    return {
        ok      => 1,
        pattern => $pattern,
        action  => 'added',
    };
}

return { error => "Unknown action: $action" };

PERL
