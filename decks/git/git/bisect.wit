#!wit/toml
author="CLAM"
description="Automated binary search for bug introduction — find which commit broke it"
enabled=true
license="Artistic-2.0"
name="git_bisect"
notes="Git bisect automation. Runs binary search between good and bad commits.\nExecutes test command at each step to narrow down the culprit.\nReports the commit that introduced the bug.\n"
priority=10
timeout=120
type="rule"
usage="Input: { path: \".\", good: \"abc123\", bad: \"HEAD\", test: \"prove -l t/test.t\" }\nOutput: { found: true, culprit: \"def456\", message: \"...\", steps: 5 }\n"
version="1.0.0"
triggers=[
  "git_bisect",
]

[metadata]
category="git"
complexity="moderate"
output_format="{ found: bool, culprit: { hash, author, message }, steps: N }"
requires_context="{ path: '...', good: '...', bad: '...', test: '...' }"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $path = ref $input eq 'HASH' ? ($input->{path} // '.') : '.';
my $good = ref $input eq 'HASH' ? ($input->{good} // '') : '';
my $bad = ref $input eq 'HASH' ? ($input->{bad} // 'HEAD') : 'HEAD';
my $test_cmd = ref $input eq 'HASH' ? ($input->{test} // '') : '';
my $auto_start = ref $input eq 'HASH' ? ($input->{auto_start} // 1) : 1;

return { error => "No good commit specified" } unless $good;
return { error => "No test command specified" } unless $test_cmd;

# Start bisect
if ($auto_start) {
    my $start = `cd '$path' && git bisect start && git bisect bad $bad && git bisect good $good 2>&1`;
    if ($? >> 8 != 0) {
        return { error => "Bisect start failed: $start" };
    }
}

# Run bisect with test command
my $output = `cd '$path' && git bisect run $test_cmd 2>&1`;
my $exit = $? >> 8;

# Parse output for culprit
my $culprit = '';
my $message = '';
my $steps = 0;
my $found = 0;

for my $line (split /\n/, $output) {
    # Count bisect steps
    $steps++ if $line =~ /bisect/i && $line =~ /step/i;

    # Find culprit commit
    if ($line =~ /^([0-9a-f]{7,40})\s+is the first bad commit$/i) {
        $culprit = $1;
        $found = 1;
    }

    # Get commit message
    if ($found && $line =~ /^commit\s+[0-9a-f]/) {
        # Next line might be the message
    }
    if ($found && $line =~ /^Author:\s+(.+)$/i) {
        # Skip author line
    }
    if ($found && $line =~ /^(?:\s{4}|\t)(.+)$/ && !$message) {
        $message = $1;
    }
}

# If we found a culprit, get more details
if ($culprit) {
    my $details = `cd '$path' && git log -1 --pretty=format:"%H|%h|%an|%ai|%s" $culprit 2>/dev/null`;
    if ($details =~ /^([0-9a-f]{40})\|([0-9a-f]+)\|(.+?)\|(.+?)\|(.+)$/) {
        $message = $5;
        $culprit = {
            hash   => $1,
            short  => $2,
            author => $3,
            date   => $4,
            message => $5,
        };
    }
}

# Clean up bisect
`cd '$path' && git bisect reset 2>/dev/null`;

return {
    topic  => 'git.bisect',
    found  => $found,
    culprit => $culprit,
    message => $message,
    steps  => $steps,
    good   => $good,
    bad    => $bad,
};

PERL
