#!wit/toml
author="CLAM"
description="Web search provider: Yandex XML Search API"
enabled=1
license="Artistic-2.0"
name="search_yandex"
notes="Requires Yandex XML Search API key. Good for Russian/Eastern European content.\n1000 queries/day free tier.\n"
priority=30
stateful=1
timeout=10
type="agent"
usage="Input: { action: \"search\", query: \"Perl tie IPC\", limit: 5 }\nInput: { action: \"configure\", api_key: \"...\" }\nOutput: { results: [{ content, url, title, provenance }] }\n"
version="1.0.0"
publishes=[
  "search.yandex.results",
]
triggers=[
  "search_yandex",
]

[metadata]
category="search"
complexity="moderate"
cost="low"
output_format="{ topic: 'search.yandex.results', results: [{ content, title, url, provenance }] }"
requires_context="{ action: 'search|configure', query: '...', api_key?: '...' }"
requires_network=true
when_to_use="Provider: Yandex Search. Good for Russian/Eastern European content. Needs API key."

[metadata.queryable]
action="search"
ttl=1800
weight=0.3
fields=[
  "query",
]
types=[
  "web",
  "knowledge",
  "solution",
  "all",
]
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $action = ref $input eq 'HASH' ? ($input->{action} // 'search') : 'search';
my $state = $ctx{state} // {};

$state->{api_key} //= $ctx{config}{yandex_api_key} // '';
$state->{last_query} //= 0;
$state->{min_interval} //= 1;

if ($action eq 'configure') {
    $state->{api_key} = ref $input eq 'HASH' ? ($input->{api_key} // $state->{api_key}) : $state->{api_key};
    return { topic => 'search.yandex.configured', has_key => !!$state->{api_key} };
}

if ($action eq 'search') {
    my $query = ref $input eq 'HASH' ? ($input->{query} // '') : '';
    my $limit = ref $input eq 'HASH' ? ($input->{limit} // 5) : 5;
    return { error => "No query" } unless $query;
    return { error => "Not configured — need api_key", topic => 'search.yandex.results', results => [] }
        unless $state->{api_key};

    my $now = time();
    if ($now - $state->{last_query} < $state->{min_interval}) {
        return { topic => 'search.yandex.results', results => [], error => "Rate limited" };
    }
    $state->{last_query} = $now;

    my $encoded = $query;
    $encoded =~ s/ /+/g;
    $encoded =~ s/([^A-Za-z0-9])/sprintf("%%%02X", ord($1))/ge;
    my $url = "https://yandex.com/search/xml?query=$encoded&lr=213&numdoc=$limit&apikey=$state->{api_key}";

    my $response = _fetch($url);
    return { topic => 'search.yandex.results', results => [] } unless $response;

    my @results;
    # Yandex returns XML — parse with regex for simplicity
    while ($response =~ /<url>(.*?)<\/url>.*?<title>(.*?)<\/title>.*?<headline>(.*?)<\/headline>/gs) {
        my ($url, $title, $snippet) = ($1, $2, $3);
        # Unescape XML entities
        s/&amp;/&/g for $url, $title, $snippet;
        s/&lt;/</g for $url, $title, $snippet;
        s/&gt;/>/g for $url, $title, $snippet;
        s/&quot;/"/g for $url, $title, $snippet;

        push @results, {
            content    => $snippet,
            text       => $snippet,
            title      => $title,
            _provider  => 'yandex',
            _weight    => 0.3,
            _timestamp => time(),
            _url       => $url,
            _ref       => "yandex:$url",
            _score     => 0.6,
        };
        last if @results >= $limit;
    }

    return { topic => 'search.yandex.results', results => \@results };
}

return { error => "Unknown action: $action" };

sub _fetch {
    my ($url) = @_;
    if (eval { require HTTP::Tiny; 1 }) {
        my $http = HTTP::Tiny->new(timeout => 8, agent => 'CLAM/1.0');
        my $res = $http->get($url);
        return $res->{content} if $res->{success};
    } elsif (eval { require LWP::UserAgent; 1 }) {
        my $http = LWP::UserAgent->new(timeout => 8, agent => 'CLAM/1.0');
        my $res = $http->get($url);
        return $res->decoded_content if $res->is_success;
    }
    return undef;
}

PERL
