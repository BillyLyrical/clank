#!wit/toml
author="CLAM"
description="General-purpose context gatherer: parallel search across pluggable providers"
enabled=1
license="Artistic-2.0"
name="search"
notes="Core search orchestrator. Providers are separate wits that register\nwith this gatherer. Fan-out → merge → rank → dedup → cache → return.\nEvery result carries provenance: source, timestamp, url, ref, score.\nThis wit knows nothing about what's being searched — pure mechanism.\nSpecializations (user_search, bed_search) compose this with domain sources.\n"
priority=10
stateful=1
timeout=10
type="agent"
usage="Input: { action: \"search\", query: \"how to fix Perl IPC\" }\nInput: { action: \"register\", provider: \"web\", weight: 0.3, types: [\"web\", \"solution\"] }\nInput: { action: \"providers\" }\nOutput: { results: [{ content, provenance }], count, cached }\n"
version="1.0.0"
publishes=[
  "search.results",
  "search.registered",
]
subscribes=[
  "search.*",
]
triggers=[
  "search",
]

[metadata]
category="system"
complexity="high"
cost="medium"
output_format="{ topic: 'search.results', results: [{ content, provenance }], count, cached }"
requires_context="{ action: 'search|register|unregister|providers|cache_clear', query?: '...', sources?: [...] }"
when_to_use="Core search mechanism. Compose with domain-specific source wits."

[metadata.queryable]
action="search"
ttl=0
weight=0.0
fields=[
  "query",
]
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $action = ref $input eq 'HASH' ? ($input->{action} // 'search') : 'search';
my $state = $ctx{state} // {};
my $bus = $ctx{bus};

$state->{providers} //= {};
$state->{cache} //= {};
$state->{default_ttl} //= 1800;
$state->{query_log} //= [];

if ($action eq 'register') {
    my $name = ref $input eq 'HASH' ? ($input->{provider} // '') : '';
    my $weight = ref $input eq 'HASH' ? ($input->{weight} // 0.5) : 0.5;
    my $ttl = ref $input eq 'HASH' ? ($input->{ttl} // $state->{default_ttl}) : $state->{default_ttl};
    my $types = ref $input eq 'HASH' ? ($input->{types} // ['all']) : ['all'];
    my $topic = ref $input eq 'HASH' ? ($input->{topic} // "search.$name") : "search.$name";
    return { error => "No provider" } unless $name;

    $state->{providers}{$name} = {
        name   => $name,
        weight => $weight,
        ttl    => $ttl,
        types  => $types,
        topic  => $topic,
        active => 1,
    };
    return { topic => 'search.registered', provider => $name };
}

if ($action eq 'unregister') {
    my $name = ref $input eq 'HASH' ? ($input->{provider} // '') : '';
    delete $state->{providers}{$name};
    return { topic => 'search.unregistered', provider => $name };
}

if ($action eq 'providers') {
    return { topic => 'search.providers', providers => [sort keys %{$state->{providers}}] };
}

if ($action eq 'search') {
    my $query = ref $input eq 'HASH' ? ($input->{query} // '') : '';
    my $sources = ref $input eq 'HASH' ? ($input->{sources} // []) : [];
    my $types = ref $input eq 'HASH' ? ($input->{types} // []) : [];
    my $limit = ref $input eq 'HASH' ? ($input->{limit} // 10) : 10;
    my $force = ref $input eq 'HASH' ? ($input->{force} // 0) : 0;
    return { error => "No query" } unless $query;

    # Cache check
    my $ck = _cache_key($query, $sources, $types);
    if (!$force && $state->{cache}{$ck}) {
        my $c = $state->{cache}{$ck};
        if (time() - $c->{time} < ($c->{ttl} // $state->{default_ttl})) {
            return { topic => 'search.results', results => $c->{results}, cached => 1, age => time() - $c->{time} };
        }
        delete $state->{cache}{$ck};
    }

    # Route to providers
    my @active = grep { $_->{active} } values %{$state->{providers}};
    @active = grep { my $n = $_->{name}; grep { $n =~ /$_/ } @$sources } @active if @$sources;
    @active = grep { my $t = $_->{types}; !@$types || grep { my $x = $_; grep { $x eq $_ || $_ eq 'all' } @$t } @$types } @active if @$types;

    # Fan-out
    my @all;
    for my $p (@active) {
        my $results = eval { $bus ? $bus->publish($p->{topic}, { query => $query, limit => $limit }) : undef };
        next unless ref $results eq 'HASH' && ref $results->{results} eq 'ARRAY';
        for my $r (@{$results->{results}}) {
            $r->{_provider} = $p->{name};
            $r->{_weight} = $p->{weight};
        }
        push @all, @{$results->{results}};
    }

    # Rank
    @all = _rank(\@all);
    @all = _dedup(\@all);
    @all = @all[0..$limit-1] if @all > $limit;

    # Attach provenance
    for my $r (@all) {
        $r->{provenance} = {
            provider  => $r->{_provider} // 'unknown',
            timestamp => $r->{_timestamp} // time(),
            url       => $r->{_url} // '',
            ref       => $r->{_ref} // '',
            score     => $r->{_final_score} // 0,
        };
        delete $r->{_provider};
        delete $r->{_weight};
        delete $r->{_score};
        delete $r->{_timestamp};
        delete $r->{_url};
        delete $r->{_ref};
        delete $r->{_final_score};
    }

    # Cache
    my $ttl = $state->{default_ttl};
    for my $p (@active) { $ttl = $p->{ttl} if $p->{ttl} < $ttl; }
    $state->{cache}{$ck} = { results => \@all, time => time(), ttl => $ttl };

    # Log
    push @{$state->{query_log}}, { query => $query, results => scalar @all, time => time() };
    $state->{query_log} = [@{$state->{query_log}}[-100..-1]] if @{$state->{query_log}} > 100;

    return {
        topic   => 'search.results',
        results => \@all,
        count   => scalar @all,
        cached  => 0,
        sources => [map { $_->{name} } @active],
    };
}

if ($action eq 'cache_clear') {
    my $query = ref $input eq 'HASH' ? ($input->{query} // '') : '';
    if ($query) { delete $state->{cache}{_cache_key($query, [], [])}; }
    else { $state->{cache} = {}; }
    return { topic => 'search.cache_cleared', all => !$query };
}

return { error => "Unknown action: $action" };

sub _cache_key {
    my ($q, $src, $typ) = @_;
    require Digest::MD5;
    return Digest::MD5::md5_hex($q . '|' . join(',', sort @$src) . '|' . join(',', sort @$typ));
}

sub _rank {
    my ($results) = @_;
    for my $r (@$results) {
        my $rel = $r->{_score} // 0.5;
        my $w = $r->{_weight} // 0.5;
        my $rec = 1.0;
        if ($r->{_timestamp}) {
            $rec = 1.0 / (1.0 + (time() - $r->{_timestamp}) / 86400);
        }
        $r->{_final_score} = $rel * 0.5 + $rec * 0.3 + $w * 0.2;
    }
    return sort { $b->{_final_score} <=> $a->{_final_score} } @$results;
}

sub _dedup {
    my ($results) = @_;
    my (@seen, @out);
    for my $r (@$results) {
        my $sig = substr($r->{content} // $r->{text} // '', 0, 100);
        my $dup = 0;
        for my $s (@seen) {
            my @wa = split /\s+/, lc($sig);
            my @wb = split /\s+/, lc($s);
            my %c; $c{$_} = 1 for grep { my $w = $_; grep { $w eq $_ } @wb } @wa;
            my $tot = @wa + @wb - scalar keys %c;
            $dup = 1 if $tot > 0 && scalar(keys %c) / $tot > 0.7;
        }
        unless ($dup) { push @seen, $sig; push @out, $r; }
    }
    return @out;
}

PERL
