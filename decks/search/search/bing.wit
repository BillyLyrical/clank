#!wit/toml
author="CLAM"
description="Web search provider: Bing Web Search API"
enabled=1
license="Artistic-2.0"
name="search_bing"
notes="Requires Azure Cognitive Services Bing Search API key.\n1000 queries/month free tier.\n"
priority=30
stateful=1
timeout=10
type="agent"
usage="Input: { action: \"search\", query: \"Perl tie IPC\", limit: 5 }\nInput: { action: \"configure\", api_key: \"...\" }\nOutput: { results: [{ content, url, title, provenance }] }\n"
version="1.0.0"
publishes=[
  "search.bing.results",
]
triggers=[
  "search_bing",
]

[metadata]
category="search"
complexity="moderate"
cost="low"
output_format="{ topic: 'search.bing.results', results: [{ content, title, url, provenance }] }"
requires_context="{ action: 'search|configure', query: '...', api_key?: '...' }"
requires_network=true
when_to_use="Provider: Bing Web Search. Needs Azure API key."

[metadata.queryable]
action="search"
ttl=1800
weight=0.3
fields=[
  "query",
]
types=[
  "web",
  "knowledge",
  "solution",
  "all",
]
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $action = ref $input eq 'HASH' ? ($input->{action} // 'search') : 'search';
my $state = $ctx{state} // {};

$state->{api_key} //= $ctx{config}{bing_api_key} // '';
$state->{last_query} //= 0;
$state->{min_interval} //= 1;

if ($action eq 'configure') {
    $state->{api_key} = ref $input eq 'HASH' ? ($input->{api_key} // $state->{api_key}) : $state->{api_key};
    return { topic => 'search.bing.configured', has_key => !!$state->{api_key} };
}

if ($action eq 'search') {
    my $query = ref $input eq 'HASH' ? ($input->{query} // '') : '';
    my $limit = ref $input eq 'HASH' ? ($input->{limit} // 5) : 5;
    return { error => "No query" } unless $query;
    return { error => "Not configured — need api_key", topic => 'search.bing.results', results => [] }
        unless $state->{api_key};

    my $now = time();
    if ($now - $state->{last_query} < $state->{min_interval}) {
        return { topic => 'search.bing.results', results => [], error => "Rate limited" };
    }
    $state->{last_query} = $now;

    my $encoded = $query;
    $encoded =~ s/ /+/g;
    $encoded =~ s/([^A-Za-z0-9])/sprintf("%%%02X", ord($1))/ge;
    my $url = "https://api.bing.microsoft.com/v7.0/search?q=$encoded&count=$limit";

    my $response = _fetch($url, $state->{api_key});
    return { topic => 'search.bing.results', results => [] } unless $response;

    my $data = eval { JSON::XS::decode_json($response) };
    return { topic => 'search.bing.results', results => [] } unless ref $data eq 'HASH';

    my @results;
    for my $item (@{$data->{webPages}{value} // []}) {
        push @results, {
            content    => $item->{snippet} // '',
            text       => $item->{snippet} // '',
            title      => $item->{name} // '',
            _provider  => 'bing',
            _weight    => 0.3,
            _timestamp => time(),
            _url       => $item->{url} // '',
            _ref       => 'bing:' . ($item->{displayUrl} // ''),
            _score     => 0.65,
        };
    }

    return { topic => 'search.bing.results', results => \@results };
}

return { error => "Unknown action: $action" };

sub _fetch {
    my ($url, $key) = @_;
    if (eval { require HTTP::Tiny; 1 }) {
        my $http = HTTP::Tiny->new(timeout => 8, agent => 'CLAM/1.0');
        my $res = $http->get($url, { headers => { 'Ocp-Apim-Subscription-Key' => $key } });
        return $res->{content} if $res->{success};
    } elsif (eval { require LWP::UserAgent; 1 }) {
        my $http = LWP::UserAgent->new(timeout => 8, agent => 'CLAM/1.0');
        my $res = $http->get($url, 'Ocp-Apim-Subscription-Key' => $key);
        return $res->decoded_content if $res->is_success;
    }
    return undef;
}

PERL
