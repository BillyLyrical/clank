#!wit/toml
author="CLAM"
description="LLM search provider: queries local LLM for analysis, summaries, answers"
enabled=1
license="Artistic-2.0"
name="search_llm"
notes="Uses local LLM as a search/knowledge source. Not for code generation —\nfor answering questions, summarizing concepts, analyzing patterns.\nReturns provenance with model name and prompt used.\nRate-limited by LLM endpoint capacity.\n"
priority=35
stateful=1
timeout=20
type="agent"
usage="Input: { action: \"search\", query: \"explain Perl tie() for IPC\", limit: 3 }\nOutput: { results: [{ content, provenance }] }\n"
version="1.0.0"
publishes=[
  "search.llm.results",
]
triggers=[
  "search_llm",
]

[metadata]
category="search"
complexity="moderate"
cost="medium"
output_format="{ topic: 'search.llm.results', results: [{ content, provenance }] }"
requires_context="{ action: 'search|configure', query: '...', model?: '...' }"
requires_network=true
when_to_use="Provider: queries local LLM for analysis, summaries, factual answers."

[metadata.queryable]
action="search"
ttl=3600
weight=0.4
fields=[
  "query",
]
types=[
  "knowledge",
  "analysis",
  "solution",
  "all",
]
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $action = ref $input eq 'HASH' ? ($input->{action} // 'search') : 'search';
my $state = $ctx{state} // {};

$state->{endpoint} //= 'http://maniac:1234/v1/chat/completions';
$state->{model} //= 'mimo-auto';
$state->{last_query} //= 0;
$state->{min_interval} //= 2;  # seconds between queries

if ($action eq 'search') {
    my $query = ref $input eq 'HASH' ? ($input->{query} // '') : '';
    my $limit = ref $input eq 'HASH' ? ($input->{limit} // 1) : 1;
    my $context = ref $input eq 'HASH' ? ($input->{context} // '') : '';
    return { error => "No query" } unless $query;

    # Rate limiting
    my $now = time();
    my $wait = $state->{min_interval} - ($now - $state->{last_query});
    if ($wait > 0) {
        return { topic => 'search.llm.results', results => [], error => "Rate limited, wait ${wait}s" };
    }
    $state->{last_query} = $now;

    # Build prompt — instruct LLM to answer, not generate code
    my $prompt = "Answer this question concisely. Focus on facts, not opinions.\n\n$query";
    $prompt .= "\n\nContext: $context" if $context;

    # Query LLM
    my $answer = _query_llm($state->{endpoint}, $state->{model}, $prompt);
    return { topic => 'search.llm.results', results => [] } unless $answer;

    my @results = ({
        content    => $answer,
        text       => $answer,
        title      => "LLM: $query",
        _provider  => 'llm',
        _weight    => 0.4,
        _timestamp => time(),
        _url       => '',
        _ref       => "llm:$state->{model}",
        _score     => 0.6,
    });

    return { topic => 'search.llm.results', results => \@results };
}

if ($action eq 'configure') {
    my $endpoint = ref $input eq 'HASH' ? ($input->{endpoint} // '') : '';
    my $model = ref $input eq 'HASH' ? ($input->{model} // '') : '';
    $state->{endpoint} = $endpoint if $endpoint;
    $state->{model} = $model if $model;
    return { topic => 'search.llm.configured', endpoint => $state->{endpoint}, model => $state->{model} };
}

return { error => "Unknown action: $action" };

sub _query_llm {
    my ($endpoint, $model, $prompt) = @_;
    my $payload = encode_json({
        model    => $model,
        messages => [{ role => 'user', content => $prompt }],
        max_tokens => 500,
        temperature => 0.3,
    });

    my $response = '';
    if (eval { require HTTP::Tiny; 1 }) {
        my $http = HTTP::Tiny->new(timeout => 15, agent => 'CLAM/1.0');
        my $res = $http->post($endpoint, {
            content => $payload,
            headers => { 'Content-Type' => 'application/json' },
        });
        $response = $res->{content} if $res->{success};
    } elsif (eval { require LWP::UserAgent; 1 }) {
        my $http = LWP::UserAgent->new(timeout => 15, agent => 'CLAM/1.0');
        my $res = $http->post($endpoint, Content => $payload, 'Content-Type' => 'application/json');
        $response = $res->decoded_content if $res->is_success;
    }

    return undef unless $response;
    my $data = eval { decode_json($response) };
    return undef unless ref $data eq 'HASH';
    return $data->{choices}[0]{message}{content} // undef;
}

sub encode_json {
    require JSON::XS;
    return JSON::XS::encode_json($_[0]);
}

sub decode_json {
    require JSON::XS;
    return JSON::XS::decode_json($_[0]);
}

PERL
