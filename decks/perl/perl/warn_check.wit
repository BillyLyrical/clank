#!wit/toml
author="CLAM"
description="Find potential Perl warnings, suggest fixes"
enabled=true
license="Artistic-2.0"
name="perl_warn_check"
notes="Static analysis for common warning patterns.\nSuggests fixes for each warning.\n"
priority=10
timeout=10
type="rule"
usage="Input: { code: \"print $x; my $y = $undefined;\" }\nOutput: { warnings: [{ type: \"uninitialized\", line: 1, msg: \"Use of uninitialized value\" }] }\n"
version="1.0.0"
triggers=[
  "perl_warn_check",
]

[metadata]
category="perl"
complexity="simple"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $code = ref $input eq 'HASH' ? ($input->{code} // '') : $input;

return { warnings => [] } unless $code;

my @warnings;
my @lines = split /\n/, $code;

for my $i (0 .. $#lines) {
    my $line = $lines[$i];
    my $num = $i + 1;

    # Uninitialized variable
    if ($line =~ /\$(\w+)\s*(?:[!=<>]=|[\+\-\*\/])/ && $line !~ /\bdefined\b/) {
        push @warnings, {
            type   => 'uninitialized',
            line   => $num,
            msg    => "Variable \$$1 may be uninitialized",
            fix    => "Add defined($1) check or initialize",
        };
    }

    # Bare string comparison
    if ($line =~ /\$[\w]+\s*eq\s*['"]/) {
        push @warnings, {
            type   => 'style',
            line   => $num,
            msg    => "String comparison — consider using 'eq' explicitly",
            fix    => "Ensure consistent string comparison",
        };
    }

    # Array element in scalar context
    if ($line =~ /\@(\w+)\s*(?:[=!<>]=|\+)/) {
        push @warnings, {
            type   => 'scalar_context',
            line   => $num,
            msg    => "Array \@$1 in scalar context — returns array size",
            fix    => "Use scalar(\@$1) for clarity",
        };
    }

    # Regex without anchors
    if ($line =~ m{[^\\]/} && $line !~ /\$\s*\/$/ && $line !~ /\\[nzb]/) {
        push @warnings, {
            type   => 'regex',
            line   => $num,
            msg    => "Regex may need anchors (^ or \$)",
            fix    => "Add ^ or \$ if matching start/end of string",
        };
    }
}

return { warnings => \@warnings };

PERL
