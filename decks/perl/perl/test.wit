#!wit/toml
author="CLAM"
description="Run Perl tests and parse TAP output"
enabled=true
license="Artistic-2.0"
name="perl_test"
notes="Runs prove or perl on test files.\nParses TAP output for pass/fail counts.\n"
priority=10
timeout=60
type="rule"
usage="Input: { file: \"t/01_test.t\" } or { dir: \"t/\" }\nOutput: { passed: 10, failed: 2, total: 12, errors: [...] }\n"
version="1.0.0"
triggers=[
  "perl_test",
]

[metadata]
category="perl"
command="prove"
complexity="simple"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $file = ref $input eq 'HASH' ? ($input->{file} // '') : $input;
my $dir  = ref $input eq 'HASH' ? ($input->{dir}  // '') : '';

my $target = $file || $dir || 't/';
return { error => "No test file or directory specified" } unless $target;

my $output = `$^X -Ilib prove -v $target 2>&1`;
my $exit = $? >> 8;

my ($passed, $failed, $total) = (0, 0, 0);
my @errors;

for my $line (split /\n/, $output) {
    if ($line =~ /^(\d+)\.\.(\d+)/) {
        $total = $2;
    }
    elsif ($line =~ /^ok\s+(\d+)/) {
        $passed++;
    }
    elsif ($line =~ /^not ok\s+(\d+)/) {
        $failed++;
        push @errors, "Test $1 failed";
    }
    elsif ($line =~ /Failed (\d+)/) {
        $failed = $1;
    }
}

return {
    passed => $passed,
    failed => $failed,
    total  => $total,
    exit   => $exit,
    errors => \@errors,
    output => $output,
};

PERL
