#!wit/toml
author="CLAM"
description="Check which Perl modules are used and which are missing"
enabled=true
license="Artistic-2.0"
name="perl_deps"
notes="Scans code for use/require statements.\nChecks if each module is installed.\n"
priority=10
timeout=10
type="rule"
usage="Input: { code: \"use DBI; use Moose; use Fake::Module;\" }\nOutput: { used: [\"DBI\", \"Moose\"], missing: [\"Fake::Module\"], installed: [\"DBI\", \"Moose\"] }\n"
version="1.0.0"
triggers=[
  "perl_deps",
]

[metadata]
category="perl"
complexity="simple"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $code = ref $input eq 'HASH' ? ($input->{code} // '') : $input;

return { used => [], missing => [], installed => [] } unless $code;

my @modules;
while ($code =~ /\b(?:use|require)\s+([A-Z][A-Za-z0-9_:]+)/g) {
    push @modules, $1 unless grep { $_ eq $1 } @modules;
}

my @installed;
my @missing;

for my $mod (@modules) {
    my $file = $mod;
    $file =~ s{::}{/}g;
    $file .= '.pm';

    if (eval { require $mod; 1 }) {
        push @installed, $mod;
    } else {
        push @missing, $mod;
    }
}

return {
    used      => \@modules,
    installed => \@installed,
    missing   => \@missing,
};

PERL
