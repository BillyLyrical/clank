#!wit/toml
author="CLAM"
description="Read Perl module POD: extract subs, docs, interface"
enabled=1
license="Artistic-2.0"
name="pod_read"
notes="Extracts function signatures from ^sub/^my sub lines in Perl modules.\nReads POD sections for documentation.\nUseful for understanding what a module provides without reading all source.\nThree modes: module (by name), file (by path), grep (just subs).\n"
priority=10
stateful=0
timeout=5
type="agent"
usage="Input: { module: \"Clam::Memory\" }\nInput: { module: \"JSON::XS\", section: \"DESCRIPTION\" }\nInput: { file: \"/path/to/Module.pm\", subs: 1 }\nOutput: { subs: [...], pod: \"...\", file: \"...\" }\n"
version="1.0.0"
publishes=[
  "pod.read",
]
triggers=[
  "pod_read",
]

[metadata]
category="perl"
complexity="simple"
cost="low"
output_format="{ topic: 'pod.read', subs: [{ name, line, sig }], pod, stats }"
requires_context="{ module?: 'Foo::Bar', file?: '/path/to.pm', section?: 'DESCRIPTION' }"
when_to_use="Use when examining Perl modules — extract subs, POD docs, interface."
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $module = ref $input eq 'HASH' ? ($input->{module} // '') : '';
my $file = ref $input eq 'HASH' ? ($input->{file} // '') : '';
my $section = ref $input eq 'HASH' ? ($input->{section} // '') : '';
my $grep_mode = ref $input eq 'HASH' ? ($input->{subs} // 0) : 0;

# Resolve module name to file
if ($module && !$file) {
    my $path = $module;
    $path =~ s{::}{/}g;
    $path .= ".pm";
    # Search @INC
    for my $dir (@INC) {
        my $try = "$dir/$path";
        if (-f $try) { $file = $try; last; }
    }
    return { error => "Module not found: $module", searched => \@INC } unless $file;
}

return { error => "No module or file specified" } unless $file;
return { error => "File not found: $file" } unless -f $file;

open my $fh, '<', $file or return { error => "Cannot read: $file" };
my @lines = <$fh>;
close $fh;
chomp @lines;

my $content = join("\n", @lines);

# Extract subs
my @subs;
for my $i (0..$#lines) {
    my $line = $lines[$i];
    if ($line =~ /^(?:my\s+)?sub\s+(\w+)/) {
        my $name = $1;
        # Grab the next few lines for signature hints
        my @sig_lines;
        for my $j ($i+1..$i+5) {
            last unless defined $lines[$j];
            my $l = $lines[$j];
            $l =~ s/^\s+//;
            push @sig_lines, $l;
            last if $l =~ /\{/;
        }
        push @subs, {
            name => $name,
            line => $i + 1,
            sig  => join(" ", @sig_lines),
        };
    }
}

# Extract POD
my @pod;
my $in_pod = 0;
my $current_section = '';
my %pod_sections;

for my $line (@lines) {
    if ($line =~ /^=(\w+)/) {
        $in_pod = 1;
        $current_section = $1;
        push @pod, $line;
        next;
    }
    if ($line =~ /^=cut/) {
        $in_pod = 0;
        push @pod, $line;
        next;
    }
    if ($in_pod) {
        push @pod, $line;
        $pod_sections{$current_section} //= [];
        push @{$pod_sections{$current_section}}, $line;
    }
}

my $pod_text = join("\n", @pod);

# Filter by section if requested
if ($section && $pod_sections{$section}) {
    $pod_text = join("\n", @{$pod_sections{$section}});
}

# Stats
my $total_lines = scalar @lines;
my $pod_lines = scalar @pod;
my $code_lines = $total_lines - $pod_lines - 1;  # subtract =head and =cut

return {
    topic    => 'pod.read',
    module   => $module,
    file     => $file,
    subs     => \@subs,
    sub_count => scalar @subs,
    pod      => $pod_text,
    pod_sections => [sort keys %pod_sections],
    stats    => {
        total_lines => $total_lines,
        code_lines  => $code_lines,
        pod_lines   => $pod_lines,
        sub_count   => scalar @subs,
    },
};

PERL
