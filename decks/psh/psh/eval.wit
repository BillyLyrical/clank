#!wit/toml
author="CLAM"
description="Execute Perl code or shell commands — syntax check, eval, capture result"
enabled=1
license="Artistic-2.0"
name="psh_eval"
notes="Psh REPL evaluator.\nShell commands (starting with !) execute directly via qx||.\nPerl code gets perl -c syntax check before eval.\nVariables declared with 'our' persist between evals.\n$_ holds the last result.\n"
priority=50
stateful=true
timeout=30
type="agent"
usage="Input: { code: \"use Clam::Auth; my $auth = Clam::Auth->new\" }\nInput: { code: \"!ls -la\" }\nOutput: { ok: true, result: \"...\", type: \"perl\"|\"shell\" }\n"
version="1.0.0"
triggers=[
  "psh_eval",
]

[metadata]
category="psh"
complexity="moderate"
output_format="{ ok: bool, result: '...', type: 'perl'|'shell' }"
requires_context="{ code: '...' }"
safety="write"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $code = ref $input eq 'HASH' ? ($input->{code} // '') : $input;

return { ok => 0, error => "No code provided" } unless $code;

my $state = $ctx{state} // {};
$state->{psh} //= { vars => {}, history => [], result => '' };

# Shell command
if ($code =~ /^\s*!(.*)$/) {
    my $cmd = $1;
    my $output = `$cmd 2>&1`;
    my $exit = $? >> 8;

    $state->{psh}{result} = $output;
    push @{$state->{psh}{history}}, {
        code   => $code,
        result => $output,
        type   => 'shell',
        time   => time(),
    };

    return {
        ok     => $exit == 0,
        result => $output,
        exit   => $exit,
        type   => 'shell',
    };
}

# Perl code — syntax check
my $escaped = $code;
$escaped =~ s/'/\\'/g;
my $check_cmd = "perl -c -e '$escaped' 2>&1";
my $check_output = `$check_cmd`;
my $check_exit = $? >> 8;

if ($check_exit != 0) {
    return {
        ok     => 0,
        error  => $check_output,
        type   => 'perl',
        syntax_error => 1,
    };
}

# Build eval context with persisted vars and clam() function
my $vars_code = '';
for my $var (keys %{$state->{psh}{vars}}) {
    my $val = $state->{psh}{vars}{$var};
    $val =~ s/\\/\\\\/g;
    $val =~ s/'/\\'/g;
    $vars_code .= "our \$$var = '$val';\n";
}

my $clam_ref = $ctx{wits};
my $eval_code = $vars_code . $code;

# Execute with variable capture
my $result = eval {
    # Create a closure that captures wits and state
    my $clam_sub = sub {
        my ($wit_name, $wit_input) = @_;
        return $clam_ref->execute($wit_name, $wit_input) if $clam_ref;
        return { error => "No wits available" };
    };

    # Package with clam() function
    my $full_code = qq{
        package Psh;
        no strict 'refs';

        sub clam {
            my (\$name, \$input) = \@_;
            return \$clam_ref->execute(\$name, \$input) if \$clam_ref;
            return { error => "No wits" };
        }

        $vars_code

        # User code
        $code

        # Capture result
        \$state->{psh}{result} = \$_ // '';
    };

    eval $full_code;
};

if ($@) {
    return {
        ok     => 0,
        error  => $@,
        type   => 'perl',
    };
}

# Extract user-defined variables from main:: and stash them
for my $sym (keys %main::) {
    next if $sym =~ /^_/;
    no strict 'refs';
    my $val = *{$sym}{SCALAR};
    if ($val && defined $$val) {
        $state->{psh}{vars}{$sym} = $$val;
    }
}

# Capture $_ result
my $final_result = $state->{psh}{result} // '';

push @{$state->{psh}{history}}, {
    code   => $code,
    result => $final_result,
    type   => 'perl',
    time   => time(),
};

# Keep history bounded
if (@{$state->{psh}{history}} > 100) {
    shift @{$state->{psh}{history}};
}

return {
    ok     => 1,
    result => "$final_result",
    ref    => ref($final_result),
    type   => 'perl',
};

PERL
