#!wit/toml
author="CLAM"
description="Capture command output separately (stdout/stderr)"
enabled=true
license="Artistic-2.0"
name="fs_capture"
notes="Separates stdout and stderr.\n"
priority=10
timeout=60
type="rule"
usage="Input: { cmd: \"perl -e 'print 1'\" }\nOutput: { stdout: \"1\", stderr: \"\", exit: 0 }\n"
version="1.0.0"
triggers=[
  "fs_capture",
]

[metadata]
category="filesystem"
complexity="simple"
safety="command_execution"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $cmd = ref $input eq 'HASH' ? ($input->{cmd} // '') : $input;

return { error => "No command provided" } unless $cmd;

my $stdout = `$cmd 2>/tmp/clam_stderr_$$`;
my $exit = $? >> 8;

my $stderr = '';
if (-f "/tmp/clam_stderr_$$") {
    open my $fh, '<', "/tmp/clam_stderr_$$";
    $stderr = do { local $/; <$fh> };
    close $fh;
    unlink "/tmp/clam_stderr_$$";
}

return {
    stdout => $stdout,
    stderr => $stderr,
    exit   => $exit,
    cmd    => $cmd,
};

PERL
