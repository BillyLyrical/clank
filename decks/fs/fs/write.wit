#!wit/toml
author="CLAM"
description="Write file with backup and atomic operation"
enabled=true
license="Artistic-2.0"
name="fs_write"
notes="Creates backup before write.\nAtomic: write to temp, then rename.\n"
priority=10
timeout=10
type="rule"
usage="Input: { path: \"/tmp/test.txt\", content: \"hello\", backup: true }\nOutput: { ok: true, backup: \"/tmp/clam_backups/test.txt.20250629\", bytes: 5 }\n"
version="1.0.0"
triggers=[
  "fs_write",
]

[metadata]
category="filesystem"
complexity="moderate"
safety="write_with_backup"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $path = ref $input eq 'HASH' ? ($input->{path} // '') : $input;
my $content = ref $input eq 'HASH' ? ($input->{content} // '') : $input;
my $backup = ref $input eq 'HASH' ? ($input->{backup} // 1) : 1;

return { error => "No path provided" } unless $path;
return { error => "Path contains .." } if $path =~ /\.\./;

# Create backup if file exists and backup enabled
if ($backup && -f $path) {
    my $backup_dir = '/tmp/clam_backups';
    make_path($backup_dir) unless -d $backup_dir;

    my $backup_name = "$path." . strftime("%Y%m%d_%H%M%S", localtime);
    $backup_name =~ s{^/}{};
    $backup_name = "$backup_dir/$backup_name";

    copy($path, $backup_name) or warn "Backup failed: $!";
}

# Atomic write: write to temp, then rename
my $tmp = "$path.tmp.$$";
open my $fh, '>', $tmp or return { error => "Cannot write: $!" };
print $fh $content;
close $fh;

rename $tmp, $path or return { error => "Cannot rename: $!" };

return {
    ok     => 1,
    path   => $path,
    bytes  => length($content),
};

PERL
