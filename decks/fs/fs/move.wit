#!wit/toml
author="CLAM"
description="Move/rename file with backup"
enabled=true
license="Artistic-2.0"
name="fs_move"
notes="Backs up destination if it exists.\n"
priority=10
timeout=10
type="rule"
usage="Input: { source: \"/path/a.txt\", dest: \"/path/b.txt\" }\nOutput: { ok: true }\n"
version="1.0.0"
triggers=[
  "fs_move",
]

[metadata]
category="filesystem"
complexity="simple"
safety="write_with_backup"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $source = ref $input eq 'HASH' ? ($input->{source} // '') : '';
my $dest = ref $input eq 'HASH' ? ($input->{dest} // '') : '';

return { error => "Source and dest required" } unless $source && $dest;
return { error => "Source not found: $source" } unless -e $source;
return { error => "Source contains .." } if $source =~ /\.\./;
return { error => "Dest contains .." } if $dest =~ /\.\./;

# Backup destination if exists
if (-f $dest) {
    my $backup_dir = '/tmp/clam_backups';
    make_path($backup_dir) unless -d $backup_dir;
    my $backup_name = "$dest." . strftime("%Y%m%d_%H%M%S", localtime);
    $backup_name =~ s{^/}{};
    $backup_name = "$backup_dir/$backup_name";
    copy($dest, $backup_name) or warn "Backup failed: $!";
}

rename $source, $dest or return { error => "Move failed: $!" };

return {
    ok     => 1,
    source => $source,
    dest   => $dest,
};

PERL
