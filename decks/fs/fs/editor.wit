#!wit/toml
author="CLAM"
description="Open $EDITOR for editing files or text blocks — vim, nano, etc."
enabled=1
license="Artistic-2.0"
name="fs_editor"
notes="Spawns $EDITOR (vim, nano, etc.) for interactive editing.\nWorks with files or temporary text blocks.\nReturns edited content for further processing.\nPsh can use this when users need to write multi-line text.\n"
priority=10
timeout=300
type="rule"
usage="Input: { file: \"lib/Foo.pm\" }\nInput: { content: \"sub foo { }\" }\nInput: { file: \"/tmp/block.txt\", content: \"# Edit this:\\n\" }\nOutput: { ok: true, content: \"...\", changed: true }\n"
version="1.0.0"
triggers=[
  "fs_editor",
]

[metadata]
category="filesystem"
complexity="simple"
output_format="{ ok: bool, content: '...', changed: bool }"
requires_context="{ file?: '...', content?: '...' }"
safety="write"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $file = ref $input eq 'HASH' ? ($input->{file} // '') : '';
my $content = ref $input eq 'HASH' ? ($input->{content} // '') : '';
my $suffix = ref $input eq 'HASH' ? ($input->{suffix} // '.txt') : '.txt';

my $editor = $ENV{EDITOR} || $ENV{VISUAL} || 'vi';
my $temp_file = '';

if ($file) {
    # Edit existing file
    return { error => "File not found: $file" } unless -f $file;

    my $before = eval { local $/; open my $fh, '<', $file or die; <$fh> };

    system($editor, $file);
    my $exit = $? >> 8;

    my $after = eval { local $/; open my $fh, '<', $file or die; <$fh> };
    my $changed = defined($before) && defined($after) && $before ne $after;

    return {
        topic   => 'fs.editor',
        ok      => $exit == 0,
        file    => $file,
        content => $after,
        changed => $changed,
    };
}

if ($content || !$file) {
    # Edit text block (temp file)
    require File::Temp;
    my $fh = File::Temp->new(SUFFIX => $suffix, UNLINK => 0);
    $temp_file = $fh->filename;
    print $fh $content if $content;
    close $fh;

    system($editor, $temp_file);
    my $exit = $? >> 8;

    my $result = eval { local $/; open my $rfh, '<', $temp_file or die; <$rfh> };
    unlink $temp_file;

    my $changed = defined($result) && $result ne $content;

    return {
        topic   => 'fs.editor',
        ok      => $exit == 0,
        content => $result,
        changed => $changed,
        temp    => 1,
    };
}

return { error => "No file or content specified" };

PERL
