#!wit/toml
author="CLAM"
description="Compare two files"
enabled=true
license="Artistic-2.0"
name="fs_diff"
notes="Read-only. Shows differences between files.\n"
priority=10
timeout=10
type="rule"
usage="Input: { file1: \"/path/a.txt\", file2: \"/path/b.txt\" }\nOutput: { identical: false, differences: [...], diff: \"...\" }\n"
version="1.0.0"
triggers=[
  "fs_diff",
]

[metadata]
category="filesystem"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $file1 = ref $input eq 'HASH' ? ($input->{file1} // '') : '';
my $file2 = ref $input eq 'HASH' ? ($input->{file2} // '') : '';

return { error => "Both files required" } unless $file1 && $file2;
return { error => "File not found: $file1" } unless -f $file1;
return { error => "File not found: $file2" } unless -f $file2;

my $diff = `diff '$file1' '$file2' 2>/dev/null`;
my $identical = $? == 0;

my @differences;
for my $line (split /\n/, $diff) {
    push @differences, $line if $line =~ /^[<>]/;
}

return {
    identical   => $identical,
    differences => \@differences,
    diff        => $diff,
    file1       => $file1,
    file2       => $file2,
};

PERL
