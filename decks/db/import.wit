#!wit/toml
author="CLAM"
description="Import data — load CSV, JSON, or SQL into database tables"
enabled=true
license="Artistic-2.0"
name="dbshell_import"
notes="Imports data from files or inline data into database tables.\nCSV import auto-detects columns from header row.\nJSON import flattens hashrefs into rows.\nSQL import executes the file directly.\n"
priority=10
stateful=true
timeout=30
type="rule"
usage="Input: { action: \"csv\", file: \"users.csv\", table: \"users\" }\nInput: { action: \"json\", file: \"users.json\", table: \"users\" }\nInput: { action: \"sql\", file: \"seed.sql\" }\nInput: { action: \"csv\", data: \"col1,col2\\n1,2\\n\", table: \"test\" }\nOutput: depends on action\n"
version="1.0.0"
requires_perl=[
  "DBI",
]
triggers=[
  "dbshell_import",
]

[metadata]
category="dbshell"
complexity="moderate"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $state = $ctx{state}{dbshell} // {};
my $dbh = $state->{dbh};
my $action = ref $input eq 'HASH' ? ($input->{action} // 'csv') : 'csv';

return { ok => 0, error => "No database connected" } unless $dbh;

if ($action eq 'csv') {
  my $file = $input->{file} // '';
  my $data = $input->{data} // '';
  my $table = $input->{table} // '';
  return { ok => 0, error => "No table specified" } unless $table;

  my $csv_content;
  if ($file && -f $file) {
    open my $fh, '<', $file or return { ok => 0, error => "Cannot read: $!" };
    local $/;
    $csv_content = <$fh>;
    close $fh;
  } elsif ($data) {
    $csv_content = $data;
  } else {
    return { ok => 0, error => "No file or data provided" };
  }

  my @lines = split /\n/, $csv_content;
  return { ok => 0, error => "Empty CSV" } unless @lines;

  my @headers = _parse_csv_line(shift @lines);
  my $inserted = 0;
  my $errors = 0;

  my $dbh = $state->{dbh};
  eval {
    my $cols = join(',', map { "\"$_\"" } @headers);
    my $placeholders = join(',', ('?') x @headers);
    my $sth = $dbh->prepare("INSERT INTO \"$table\" ($cols) VALUES ($placeholders)");

    for my $line (@lines) {
      next unless $line =~ /\S/;
      my @vals = _parse_csv_line($line);
      eval {
        $sth->execute(@vals);
        $inserted++;
      };
      $errors++ if $@;
    }
  };

  return { ok => 1, inserted => $inserted, errors => $errors, table => $table, columns => \@headers };
}

if ($action eq 'json') {
  my $file = $input->{file} // '';
  my $table = $input->{table} // '';
  return { ok => 0, error => "No table specified" } unless $table;

  my $json_content;
  if ($file && -f $file) {
    open my $fh, '<', $file or return { ok => 0, error => "Cannot read: $!" };
    local $/;
    $json_content = <$fh>;
    close $fh;
  } else {
    return { ok => 0, error => "No file provided" };
  }

  eval {
    require JSON::PP;
    my $data = JSON::PP::decode_json($json_content);
    $data = [$data] unless ref $data eq 'ARRAY';

    return { ok => 0, error => "No data in JSON" } unless @$data;

    my @headers = keys %{$data->[0]};
    my $cols = join(',', map { "\"$_\"" } @headers);
    my $placeholders = join(',', ('?') x @headers);
    my $sth = $dbh->prepare("INSERT INTO \"$table\" ($cols) VALUES ($placeholders)");

    my $inserted = 0;
    for my $row (@$data) {
      eval {
        $sth->execute(map { $row->{$_} } @headers);
        $inserted++;
      };
    }

    return { ok => 1, inserted => $inserted, table => $table, columns => \@headers };
  };

  return { ok => 0, error => "Import failed: $@" };
}

if ($action eq 'sql') {
  my $file = $input->{file} // '';
  return { ok => 0, error => "No file specified" } unless $file;
  return { ok => 0, error => "File not found: $file" } unless -f $file;

  open my $fh, '<', $file or return { ok => 0, error => "Cannot read: $!" };
  local $/;
  my $sql = <$fh>;
  close $fh;

  my @statements = split /;/, $sql;
  my $executed = 0;
  my $errors = 0;

  for my $stmt (@statements) {
    $stmt =~ s/^\s+|\s+$//g;
    next unless $stmt;
    eval {
      $dbh->do($stmt);
      $executed++;
    };
    $errors++ if $@;
  }

  return { ok => 1, executed => $executed, errors => $errors, file => $file };
}

sub _parse_csv_line {
  my $line = shift;
  my @fields;
  my $field = '';
  my $in_quotes = 0;

  for my $i (0 .. length($line) - 1) {
    my $ch = substr($line, $i, 1);
    if ($ch eq '"') {
      $in_quotes = !$in_quotes;
    } elsif ($ch eq ',' && !$in_quotes) {
      push @fields, $field;
      $field = '';
    } else {
      $field .= $ch;
    }
  }
  push @fields, $field;
  return @fields;
}

PERL
