#!wit/toml
author="CLAM"
description="Execute INSERT, UPDATE, DELETE — with transaction support"
enabled=true
license="Artistic-2.0"
name="db_execute"
notes="Executes write queries (INSERT, UPDATE, DELETE).\nSupports transactions for atomic multi-statement operations.\nReturns rows affected and last insert ID.\n"
priority=10
stateful=true
timeout=30
type="rule"
usage="Input: { conn_id: \"sqlite:./data.db\", sql: \"INSERT INTO users (name) VALUES (?)\", params: [\"Alice\"] }\nInput: { conn_id: \"sqlite:./data.db\", sql: \"UPDATE users SET name = ? WHERE id = ?\", params: [\"Bob\", 1] }\nInput: { conn_id: \"sqlite:./data.db\", transaction: [{ sql: \"...\", params: [...] }] }\nOutput: { ok: true, rows_affected: 1, last_insert_id: 5 }\n"
version="1.0.0"
triggers=[
  "db_execute",
]

[metadata]
category="database"
complexity="simple"
output_format="{ ok: bool, rows_affected: N, last_insert_id: N }"
requires_context="{ conn_id: '...', sql: 'INSERT|UPDATE|DELETE ...', params?: [...] }"
safety="write"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $conn_id = ref $input eq 'HASH' ? ($input->{conn_id} // '') : '';
my $sql = ref $input eq 'HASH' ? ($input->{sql} // '') : '';
my $params = ref $input eq 'HASH' ? ($input->{params} // []) : [];
my $transaction = ref $input eq 'HASH' ? ($input->{transaction} // []) : [];

# Transaction mode
if (@$transaction) {
    return _run_transaction($conn_id, $transaction, \%ctx);
}

return { error => "No SQL specified" } unless $sql;

my $dbh = _get_dbh($conn_id, \%ctx);
return { error => "No database connection" } unless $dbh;

# Safety check — no SELECT allowed
if ($sql =~ /^\s*SELECT/i) {
    return { error => "SELECT not allowed in db_execute. Use db_query for reads." };
}

my $sth = eval { $dbh->prepare($sql) };
return { error => "Prepare failed: $@" } unless $sth;

my $ok = eval { $sth->execute(@$params) };
return { error => "Execute failed: $@" } unless $ok;

my $rows_affected = $sth->rows;
my $last_insert_id = eval { $dbh->last_insert_id(undef, undef, undef, undef) } || 0;

$sth->finish;

return {
    topic          => 'db.executed',
    ok             => 1,
    rows_affected  => $rows_affected,
    last_insert_id => $last_insert_id,
    sql            => $sql,
};

sub _run_transaction {
    my ($conn_id, $stmts, $ctx) = @_;
    my $dbh = _get_dbh($conn_id, $ctx);
    return { error => "No database connection" } unless $dbh;

    $dbh->begin_work;
    my @results;
    my $total_affected = 0;

    for my $stmt (@$stmts) {
        my $sth = eval { $dbh->prepare($stmt->{sql}) };
        unless ($sth) {
            $dbh->rollback;
            return { error => "Prepare failed in transaction: $@" };
        }

        my $ok = eval { $sth->execute(@{$stmt->{params} // []}) };
        unless ($ok) {
            $dbh->rollback;
            return { error => "Execute failed in transaction: $@" };
        }

        $total_affected += $sth->rows;
        push @results, { sql => $stmt->{sql}, rows_affected => $sth->rows };
        $sth->finish;
    }

    $dbh->commit;

    return {
        topic         => 'db.transaction',
        ok            => 1,
        statements    => scalar @results,
        total_affected => $total_affected,
        results       => \@results,
    };
}

sub _get_dbh {
    my ($conn_id, $ctx) = @_;
    my $handles = $ctx->{state}{db_handles} // {};
    return $handles->{$conn_id} if $handles->{$conn_id};
    my @ids = keys %$handles;
    return $handles->{$ids[0]} if @ids;
    return undef;
}

PERL
