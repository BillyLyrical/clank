#!wit/toml
author="CLAM"
description="Refute by contradiction — if conclusion is false, premise must be false"
enabled=true
license="Artistic-2.0"
name="deduction_contrapositive"
notes="Proof by contradiction. If the conclusion is negated, the premise must also be negated.\nModus tollens: if P→Q and ¬Q, then ¬P.\n"
priority=10
timeout=5
type="rule"
usage="Input: { rule: { if: \"code has strcpy\", then: \"overflow risk\" }, conclusion_negated: true }\nOutput: { refuted: true, premise_false: \"code does not have overflow risk\", valid: true }\n"
version="1.0.0"
triggers=[
  "deduction.contrapositive",
]

[metadata]
category="deduction"
complexity="moderate"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $rule = ref $input eq 'HASH' ? ($input->{rule} // {}) : {};
my $conclusion_negated = ref $input eq 'HASH' ? ($input->{conclusion_negated} // 0) : 0;
my $actual_conclusion = ref $input eq 'HASH' ? ($input->{actual_conclusion} // '') : '';

my $if_part = ref $rule eq 'HASH' ? ($rule->{if_part} // $rule->{if} // '') : '';
my $then_part = ref $rule eq 'HASH' ? ($rule->{then_part} // $rule->{then} // '') : '';

return { error => "Rule requires 'if' and 'then'" } unless $if_part && $then_part;

my $refuted = 0;
my $premise_false = '';
my $valid = 0;

if ($conclusion_negated || ($actual_conclusion && $actual_conclusion eq 'false')) {
    $refuted = 1;
    $premise_false = "NOT: $if_part (because NOT: $then_part)";
    $valid = 1;
} elsif ($actual_conclusion && $actual_conclusion ne 'false') {
    $refuted = 0;
    $premise_false = "Cannot refute: conclusion '$actual_conclusion' is not negated";
    $valid = 0;
} else {
    $refuted = 0;
    $premise_false = "No negation provided — contrapositive requires ¬Q";
    $valid = 0;
}

my $state = $ctx{state} // {};
my $next_id = ($state->{contra_count} // 0) + 1;
$state->{contra_count} = $next_id;
$state->{refutations} //= [];
push @{$state->{refutations}}, {
    id             => $next_id,
    rule           => $rule,
    refuted        => $refuted,
    premise_false  => $premise_false,
    valid          => $valid,
    timestamp      => scalar localtime,
};

return {
    contrapositive_id => $next_id,
    refuted           => $refuted,
    premise_false     => $premise_false,
    valid             => $valid,
    modus_tollens     => $refuted ? "¬Q ($then_part) → ¬P ($if_part)" : undef,
};
PERL
