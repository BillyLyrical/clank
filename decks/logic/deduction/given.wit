#!wit/toml
author="CLAM"
description="State a given — a specific premise for this case"
enabled=true
license="Artistic-2.0"
name="deduction_given"
notes="Concrete fact that grounds the deduction in a specific case.\n"
priority=10
timeout=5
type="rule"
usage="Input: { fact: \"this code contains strcpy(buf, input)\", context: \"c/security.wit\" }\nOutput: { given_id: 1, fact: \"...\", certainty: \"contingent\" }\n"
version="1.0.0"
triggers=[
  "deduction.given",
]

[metadata]
category="deduction"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $fact = ref $input eq 'HASH' ? ($input->{fact} // '') : $input;
my $context = ref $input eq 'HASH' ? ($input->{context} // 'direct') : 'direct';

return { error => "No fact provided" } unless $fact;

my $state = $ctx{state} // {};
my $next_id = ($state->{given_count} // 0) + 1;
$state->{given_count} = $next_id;
$state->{givens} //= [];
push @{$state->{givens}}, {
    id        => $next_id,
    fact      => $fact,
    context   => $context,
    certainty => 'contingent',
    timestamp => scalar localtime,
};

return {
    given_id  => $next_id,
    fact      => $fact,
    context   => $context,
    certainty => 'contingent',
};
PERL
