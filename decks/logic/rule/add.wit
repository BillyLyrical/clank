#!wit/toml
author="CLAM"
description="Add a classification rule to the shared ruleset. Rules persist in this DB's kv store (key rules.dsl) and are visible to every agent on it — the crystallization seam: LLM- or user-authored knowledge that outlives the session."
enabled=true
license="Artistic-2.0"
name="rule_add"
notes="Accepts either raw DSL text or structured fields compiled into one rule.\nDSL syntax (Clam::Rules::DSL):\n  rule <name> [priority N] [domain D]\n    when /regex/flags   (or a bare literal string)\n    then domain X | tag T | mode M | set K V | output TEXT\n  end\nThe registry is validated before anything is persisted.\n"
priority=10
timeout=30
type="rule"
usage="Input: { dsl?: str } or { name: str, when: str, then?: [str], priority?: int, domain?: str }\nOutput: { ok: 1, rule: name, total_rules: N } or { ok: 0, error: str }\n"
version="1.0.0"
triggers=[
  "rule.add",
]

[metadata]
category="logic"
complexity="simple"
safety="write_local"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
use Clam::Rules;

my $store = $ctx{store};
return { ok => 0, error => 'no store available' } unless $store;

# Build the DSL text for this rule.
my $dsl = $input->{dsl};
if (!defined $dsl || !length "$dsl") {
    my ($name, $when) = ($input->{name}, $input->{when});
    return { ok => 0, error => 'need dsl text or (name + when)' }
        unless defined $name && length "$name" && defined $when && length "$when";
    my @then = @{ $input->{then} // [] };
    push @then, "tag matched" unless @then;   # a rule with no action is useless
    $dsl = "rule $name\n  when $when\n" . join("\n", map { "  then $_" } @then) . "\nend\n";
}

# Validate before persisting: it must compile to at least one rule.
my $rules = eval { Clam::Rules->parse($dsl) };
return { ok => 0, error => "DSL parse failed: $@" } if $@;
return { ok => 0, error => 'DSL parsed zero rules' } unless @$rules;

# Append to the shared registry (wrapped in a hashref so kv decoding is unambiguous).
my $key = 'rules.dsl';
my $reg = $store->kv_get($key);
$reg = {} unless ref $reg eq 'HASH';
my $cur = ($reg->{dsl} // '') . "\n" . $dsl;
$store->kv_set($key, { dsl => $cur });

# Count the total rules now in the registry.
my $all = eval { Clam::Rules->parse($cur) };
return { ok => 0, error => "registry corrupted after append: $@" } if $@;

return { ok => 1, rule => $rules->[0]->name, total_rules => scalar @$all };
PERL
