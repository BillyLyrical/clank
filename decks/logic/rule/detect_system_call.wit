#!wit/toml
author="CLAM"
description="Rule: detect system call"
enabled=1
name="detect_system_call"
priority=10
stateful=0
timeout=5
type="rule"
version="1.0.0"
triggers=[
  "detect_system_call",
]

[metadata]
author="CLAM"
description="Detect system() calls"
priority=5
version=1.0
triggers=[
  "detect_system_call",
]
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $text = ref $input eq 'HASH' ? ($input->{text} // '') : $input;
if ($text =~ /\bsystem\s*\(/) {
    return { found => 1, type => 'security', suggestion => 'system() call — consider safer alternative' };
}
return undef;

PERL
