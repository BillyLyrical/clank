#!wit/toml
author="CLAM"
description="Rules-first classification of user input (policy layer). Runs the shared ruleset BEFORE the LLM: on a match it annotates the prompt with the classification and publishes it to input.classified for other agents. Inert until rules exist in this DB's rules.dsl registry; never hijacks the conversation (transform only, no handled)."
enabled=true
license="Artistic-2.0"
name="classify_input"
notes="The cheap-deterministic-before-expensive-LLM pattern from clam-old's Rules.pod.\nBus agent on 'input' -> publishes 'input.classified'. No tool use (the derived\nrule.classify_input tool exists but is not meant for LLM calls).\nAnnotation format: [rules: rule=<name> domain=<d> mode=<m>] <original text>\n"
priority=10
timeout=30
type="rule"
usage="Bus agent only. Input: the 'input' event payload { text, source }.\nOutput (published to input.classified): { action: transform, text, rule, ...classification }\n"
version="1.0.0"
triggers=[
  "rule.classify_input",
]
subscribes=[
  "input",
]
publishes=[
  "input.classified",
]

[metadata]
category="logic"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
use Clam::Rules;

my $store = $ctx{store};
return unless $store;

my $text = $input->{text} // '';
return unless length $text;

# Inert until the shared registry has rules.
my $reg = $store->kv_get('rules.dsl');
$reg = {} unless ref $reg eq 'HASH';
my $dsl = $reg->{dsl} // '';
return unless length $dsl;

# A broken registry must never break a session: pass through silently.
my $rules = eval { Clam::Rules->parse($dsl) };
return if $@ || !@$rules;

my $engine = Clam::Rules::Engine->new(store => $store, strategy => 'first');
$engine->load($rules);

my $rule = $engine->find({ text => $text });
return unless $rule;   # no match -> pass through unannotated

my $res  = $rule->execute({ text => $text }) // {};
my %res  = ref $res eq 'HASH' ? %$res : ();

my @tag = "rule=$rule->{name}";
push @tag, "domain=$res{domain}" if defined $res{domain};
push @tag, "mode=$res{mode}"     if defined $res{mode};

return {
    action => 'transform',
    text   => "[rules: " . join(' ', @tag) . "] $text",
    rule   => $rule->{name},
    %res,
};
PERL
