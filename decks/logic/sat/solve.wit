#!wit/toml
author="CLAM"
description="Run picosat on DIMACS CNF and parse result"
enabled=false
license="Artistic-2.0"
name="sat.solve"
notes="Feed DIMACS CNF to picosat, parse SAT/UNSAT and variable assignments.\nReturns model as variable=value map.\nNEEDS REVIEW: previous test used excessive RAM — do not re-enable until memory usage is profiled and bounded.\n"
priority=10
timeout=30
type="rule"
usage="Input: { dimacs: \"p cnf 3 2\\n1 2 0\\n-1 3 0\\n\" }\nOutput: { ok: true, sat: true, assignments: {1: 1, 2: 1, 3: -1} }\n"
version="1.0.0"
triggers=["sat.solve"]

[metadata]
category="sat"
complexity="moderate"
safety="moderate"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $dimacs = ref $input eq 'HASH' ? ($input->{dimacs}  // '') : "$input";
my $solver = ref $input eq 'HASH' ? ($input->{solver} // 'picosat') : 'picosat';
my $var_map= ref $input eq 'HASH' ? ($input->{var_map}// {}) : {};
my $file   = ref $input eq 'HASH' ? ($input->{file}   // '')  : '';

return { error => "dimacs or file required" } unless $dimacs || $file;

unless ($solver eq 'picosat') {
    return { error => "Only picosat is supported (minisat removed — excessive RAM usage)" };
}

# Write CNF to temp file
require File::Path;
my $workdir = $ctx{workdir}
    ? $ctx{workdir}->('sat.solve')
    : do {
        my $wd = "$FindBin::Bin/../../_work";
        File::Path::make_path($wd) unless -d $wd;
        $wd;
    };
my $cnf_file = $file || "$workdir/sat_$$.cnf";
if ($dimacs && !$file) {
    open my $fh, '>', $cnf_file or return { error => "Cannot write CNF: $!" };
    print $fh $dimacs;
    close $fh;
}

my $out_file = "$cnf_file.out";

# Run solver
my $cmd = "picosat -o $out_file $cnf_file 2>&1";

alarm(30);
my $solver_out = `$cmd`;
my $solver_exit = $? >> 8;
alarm(0);

# Parse result
my $sat = 0;
my @model;
my $unsat = 0;

if (-f $out_file) {
    open my $fh, '<', $out_file;
    while (<$fh>) {
        chomp;
        if ($_ =~ /^s\s+(SATISFIABLE|UNSATISFIABLE|SAT|UNSAT)/i) {
            $sat = ($1 =~ /SATISFIABLE/i && $1 !~ /UNSATISFIABLE/i);
            $unsat = ($1 =~ /UNSATISFIABLE/i);
        }
        if ($_ =~ /^v\s+(.*)/) {
            my @vals = split /\s+/, $1;
            @model = grep { $_ != 0 } @vals;
        }
    }
    close $fh;
} else {
    if ($solver_out =~ /SATISFIABLE/) { $sat = 1; }
    if ($solver_out =~ /UNSATISFIABLE/) { $unsat = 1; }
    if ($solver_out =~ /^v\s+(.*)/m) {
        @model = grep { $_ != 0 } split /\s+/, $1;
    }
}

# picosat exit codes: 10=sat, 20=unsat
$sat = 1 if $solver_exit == 10;
$unsat = 1 if $solver_exit == 20;

# Build assignment map
my %assignments;
for my $val (@model) {
    $assignments{abs($val)} = $val > 0 ? 1 : -1;
}

# If var_map provided, create human-readable assignment
my %readable;
if ($var_map && %$var_map) {
    for my $vname (keys %$var_map) {
        for my $val (keys %{$var_map->{$vname}}) {
            my $sv = $var_map->{$vname}{$val};
            if (exists $assignments{$sv}) {
                if ($assignments{$sv} > 0) {
                    $readable{$vname} = $val;
                }
            }
        }
    }
}

# Cleanup
unlink $cnf_file unless $file;
unlink $out_file;

return {
    ok          => 1,
    sat         => $sat ? 1 : 0,
    unsat       => $unsat ? 1 : 0,
    solver      => $solver,
    assignments => \%assignments,
    readable    => %readable ? \%readable : undef,
    model_size  => scalar @model,
    raw         => $solver_out,
};
PERL
