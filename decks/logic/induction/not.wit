#!wit/toml
author="CLAM"
description="Negate a value or condition"
enabled=true
license="Artistic-2.0"
name="induction_not"
notes="Pure logical negation. Returns the opposite of the input.\nUseful for inverting conditions, assertions, and conclusions.\n"
priority=10
timeout=5
type="rule"
usage="Input: { value: true } or { value: 0 } or { value: \"yes\" }\nOutput: { negated: false, original: true, type: \"boolean\" }\n"
version="1.0.0"
triggers=[
  "induction.not",
]

[metadata]
category="induction"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $value = ref $input eq 'HASH' ? ($input->{value} // 0) : $input;

my ($negated, $type);

if (!ref $value && ($value eq 'true' || $value eq '1')) {
    $negated = 0;
    $type = 'boolean';
} elsif (!ref $value && ($value eq 'false' || $value eq '0' || $value eq '')) {
    $negated = 1;
    $type = 'boolean';
} elsif (ref $value eq 'ARRAY') {
    $negated = scalar @$value == 0 ? 1 : 0;
    $type = 'array';
} elsif (ref $value eq 'HASH') {
    $negated = scalar keys %$value == 0 ? 1 : 0;
    $type = 'hash';
} else {
    $negated = $value ? 0 : 1;
    $type = 'truthy';
}

return {
    negated  => $negated,
    original => $value,
    type     => $type,
};
PERL
