#!wit/toml
author="CLAM"
description="Logical implication — if A then B (A implies B)"
enabled=true
license="Artistic-2.0"
name="induction_implies"
notes="Material implication: A → B. False only when A is true and B is false.\nUseful for reasoning about prerequisites and consequences.\n"
priority=10
timeout=5
type="rule"
usage="Input: { a: true, b: true }\nOutput: { result: true, a: true, b: true, description: \"true → true = true\" }\n"
version="1.0.0"
triggers=[
  "induction.implies",
]

[metadata]
category="induction"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
ref $input eq 'HASH' or return { error => "Input must be a hash" };

my $a = _to_bool($input->{a} // 0);
my $b = _to_bool($input->{b} // 0);

# A → B is false only when A is true and B is false.
my $result = (!$a || $b) ? 1 : 0;

my $desc = ($a ? "true" : "false") . " → " . ($b ? "true" : "false") . " = " . ($result ? "true" : "false");

return {
    result => $result,
    a      => $a,
    b      => $b,
    description => $desc,
};

sub _to_bool {
    my $v = shift;
    return 0 unless defined $v;
    return 0 if !ref $v && ($v eq '' || $v eq '0' || $v eq 'false');
    return 1 if ref $v eq 'ARRAY';
    return 1 if ref $v eq 'HASH' && keys %$v;
    return $v ? 1 : 0;
}
PERL
