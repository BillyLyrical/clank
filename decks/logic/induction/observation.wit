#!wit/toml
author="CLAM"
description="Record a meta-observation about the reasoning process"
enabled=true
license="Artistic-2.0"
name="induction_observation"
notes="Notable insight about the reasoning chain itself.\n"
priority=10
timeout=5
type="rule"
usage="Input: { about: \"the pattern repeats across modules\", insight: \"This suggests a systemic issue\" }\nOutput: { observation_id: 1, about: \"...\", insight: \"...\" }\n"
version="1.0.0"
triggers=[
  "induction.observation",
]

[metadata]
category="induction"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $about = ref $input eq 'HASH' ? ($input->{about} // '') : '';
my $insight = ref $input eq 'HASH' ? ($input->{insight} // $input) : $input;

return { error => "No observation provided" } unless $about || $insight;

my $state = $ctx{state} // {};
my $next_id = ($state->{observation_count} // 0) + 1;
$state->{observation_count} = $next_id;
$state->{observations} //= [];
push @{$state->{observations}}, {
    id        => $next_id,
    about     => $about,
    insight   => $insight,
    timestamp => scalar localtime,
};

return {
    observation_id => $next_id,
    about          => $about,
    insight        => $insight,
};
PERL
