#!wit/toml
author="CLAM"
description="State a theorem — a rule, principle, or heuristic"
enabled=true
license="Artistic-2.0"
name="induction_theorem"
notes="Connects observations to conclusions. States a general principle.\n"
priority=10
timeout=5
type="rule"
usage="Input: { principle: \"YAGNI: don't add code until needed\", when: \"design review\" }\nOutput: { theorem_id: 1, principle: \"...\", when: \"...\", confidence: 1.0 }\n"
version="1.0.0"
triggers=[
  "induction.theorem",
]

[metadata]
category="induction"
complexity="simple"
safety="read_only"
source = <<'PERL'
my ($self, $input, %ctx) = @_;
my $principle = ref $input eq 'HASH' ? ($input->{principle} // '') : $input;
my $when = ref $input eq 'HASH' ? ($input->{when} // 'general') : 'general';
my $confidence = ref $input eq 'HASH' ? ($input->{confidence} // 1.0) : 1.0;

return { error => "No principle provided" } unless $principle;

my $state = $ctx{state} // {};
my $next_id = ($state->{theorem_count} // 0) + 1;
$state->{theorem_count} = $next_id;
$state->{theorems} //= [];
push @{$state->{theorems}}, {
    id         => $next_id,
    principle  => $principle,
    when       => $when,
    confidence => $confidence,
    timestamp  => scalar localtime,
};

return {
    theorem_id  => $next_id,
    principle   => $principle,
    when        => $when,
    confidence  => $confidence,
};
PERL
