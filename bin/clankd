#!/usr/bin/env perl
# clankd — NDJSON front-end for Clank::Driver: drive a persistent, multi-query
# Clank session from an AI harness or any script.
#
# Transports (pick one; stdio is the default and the most portable):
#   clankd --stdio                    # newline-delimited JSON on stdin/stdout
#   clankd --socket /tmp/clankd.sock   # same protocol on a UNIX socket
#   clankd --daemon --socket /tmp/clankd.sock  # background daemon
#
# Protocol — one JSON object per line, every response echoes the request id:
#   -> {"id":1,"command":"ping"}
#   <- {"id":1,"ok":1,"pong":1}
#   -> {"id":2,"prompt":"list the files","timeout":60}
#   <- {"id":2,"ok":1,"response":"...","turns":2,"tools":[...],"events":[...]}
#   -> {"id":3,"command":"session_info"}
#   <- {"id":3,"ok":1,"session_id":"...","messages":5,...}
#   -> {"id":4,"command":"events","topic":"tool_*","limit":50}
#   -> {"id":5,"command":"tools"}
#   -> {"id":6,"command":"shutdown"}
#   <- {"id":6,"ok":1,"bye":1}        (process then exits 0)
#   -> {"id":7,"command":"status"}
#   <- {"id":7,"ok":1,"pid":12345,"uptime":42,"session_id":"..."}
#   -> {"id":8,"command":"restart"}             (resume same session)
#   <- {"id":8,"ok":1,"session_id":"...","resumed":1}
#   -> {"id":9,"command":"restart","fresh":1}   (new session, same DB)
#   <- {"id":9,"ok":1,"session_id":"...","resumed":0}
#
# Daemon mode (--daemon):
#   Double-forks, detaches from terminal, writes PID file.  The socket
#   persists across client connects/disconnects.  Use --pidfile to control
#   the PID file location (default ~/.clank/clankd.pid).  Off-line commands:
#     clankd --status   (check if daemon is running)
#     clankd --stop     (graceful shutdown via PID file)
#
# Teardown guarantees:
#   * stdio mode: EOF on stdin exits cleanly — no zombie daemons.
#   * daemon mode: PID file removed on shutdown; SIGTERM/SIGINT are handled.
#   * socket mode unlinks its socket file on every exit path.
#
# Only protocol lines go to stdout; everything else goes to stderr.
use strict;
use warnings;
use FindBin;
use lib "$FindBin::RealBin/../lib";
use Getopt::Long qw(:config no_ignore_case bundling);
use IO::Socket::UNIX;
use IO::Select;
use POSIX qw(setsid);
use Clank::Driver;
use Clank::Util qw(jencode jdecode);

sub _usage {
    my ($code) = @_;
    print STDERR "try: clankd --help\n" unless $code == 0;
    return $code;
}

my %o;
$o{wit_paths} = [];
GetOptions(
    'provider=s' => \$o{provider},
    'model=s'    => \$o{model},
    'base_url=s' => \$o{base_url},
    'api_key=s'  => \$o{api_key},
    'db=s'       => \$o{db},
    'workdir=s'  => \$o{workdir},
    'resume=s'   => \$o{resume},
    'timeout=i'  => \$o{timeout},
    'wit|w+'     => $o{wit_paths},
    'socket=s'   => \$o{socket},
    'stdio'      => \$o{stdio},
    'daemon'     => \$o{daemon},
    'pidfile=s'  => \$o{pidfile},
    'local'      => \$o{local},
    'home'       => \$o{home},
    'status'     => \$o{status},
    'stop'       => \$o{stop},
    'help'       => \$o{help},
) or exit _usage(2);

if ($o{help}) { print <<'USAGE'; exit 0; }
clankd — NDJSON front-end for Clank::Driver (multi-query Clank sessions).

Options:
  --provider=NAME   provider name (default lmstudio; 'mock' = offline echo)
  --model=NAME      model name
  --base_url=URL    OpenAI-compatible endpoint
  --api_key=KEY     API key (or CLANK_API_KEY env / config.json)
  --db=PATH         SQLite path (default: auto, see below)
  --workdir=DIR     working directory the agent operates in
  --resume=ID       continue an existing session from --db
  --timeout=N       default per-prompt timeout in seconds
  -w, --wit DIR     extra wit/deck path (repeatable)
  --local           use project-local .clank/ dir
  --home            use user-global ~/.clank/ dir
  --socket PATH     listen on a UNIX socket instead of stdio
  --stdio           force stdio transport (the default without --socket)
  --daemon          fork to background (requires --socket)
  --pidfile=PATH    PID file (default ~/.clank/clankd.pid)
  --status          check if a daemon is running, then exit
  --stop            send shutdown to a running daemon, then exit

Data directory precedence: --local > ./ .clank/ (if exists) > --home > ~/.clank/
Protocol: newline-delimited JSON; see the header comment for commands.
USAGE

my $pidfile = $o{pidfile} // "$ENV{HOME}/.clank/clankd.pid";

# --- offline commands (--status, --stop) --------------------------------------
# These operate on the PID file without starting a session.

if ($o{status} || $o{stop}) {
    open my $fh, '<', $pidfile or do {
        print jencode({ ok => 0, error => "no PID file at $pidfile" }) . "\n";
        exit 1;
    };
    my $pid = <$fh>;
    close $fh;
    chomp $pid if defined $pid;

    if (!defined $pid || $pid !~ /^\d+$/) {
        print jencode({ ok => 0, error => "corrupt PID file" }) . "\n";
        exit 1;
    }

    # Signal 0 checks if the process exists without actually signaling it.
    if (kill(0, $pid)) {
        if ($o{stop}) {
            kill 'TERM', $pid;
            # Wait briefly for clean shutdown, then verify.
            for (1 .. 5) { last unless kill(0, $pid); select(undef, undef, undef, 0.2) }
            if (kill(0, $pid)) {
                print jencode({ ok => 0, error => "daemon pid $pid did not exit" }) . "\n";
                exit 1;
            }
            unlink $pidfile if -e $pidfile;
            print jencode({ ok => 1, stopped => 1, pid => $pid }) . "\n";
        } else {
            print jencode({ ok => 1, running => 1, pid => $pid }) . "\n";
        }
    } else {
        unlink $pidfile if -e $pidfile;   # stale PID file
        print jencode({ ok => 0, error => "no running daemon (stale PID file cleaned)" }) . "\n";
        exit 1;
    }
    exit 0;
}

# --- driver init (factored out for restart) ------------------------------------
my %driver_opts = (
    provider  => $o{provider},
    model     => $o{model},
    base_url  => $o{base_url},
    api_key   => $o{api_key},
    db        => $o{db},
    workdir   => $o{workdir},
    wit_paths => $o{wit_paths},
);

require Clank::Sigil;
require Clank::App;

my ($driver, $sigil);

sub _init_driver {
    my (%override) = @_;
    my $d = eval {
        Clank::Driver->new(%driver_opts, %override)
            ->start(exists $override{resume} ? (resume => $override{resume}) : ());
    };
    if ($@) {
        print STDERR "clankd: failed to start session: $@";
        exit 1;
    }
    $driver = $d;
    $sigil = Clank::Sigil->new(app => $driver);
    _register_clankd_sigils($sigil, $driver);
    return $d;
}

_init_driver;

$| = 1;   # autoflush stdout — parents read line-by-line

my $socket_path = $o{socket};

# --- daemonization ------------------------------------------------------------
# --daemon requires --socket: stdio makes no sense for a detached process.
if ($o{daemon}) {
    die "clankd: --daemon requires --socket\n" unless $socket_path;

    # Double-fork: parent exits immediately, grandchild is fully detached.
    my $pid = fork;
    die "clankd: fork: $!" unless defined $pid;
    if ($pid) {
        # First parent: wait for child to signal readiness, then exit.
        waitpid($pid, 0);
        exit 0;
    }
    setsid or die "clankd: setsid: $!";
    my $pid2 = fork;
    die "clankd: fork: $!" unless defined $pid2;
    exit 0 if $pid2;   # first child exits

    # Grandchild: fully detached.  Close stdio (nobody listening).
    open STDIN,  '<', '/dev/null' or die "clankd: reopen stdin: $!";
    open STDOUT, '>', '/dev/null' or die "clankd: reopen stdout: $!";
    open STDERR, '>&', \*STDOUT  or die "clankd: redirect stderr: $!";

    # Write PID file.
    mkdir "$ENV{HOME}/.clank" unless -d "$ENV{HOME}/.clank";
    open my $pfh, '>', $pidfile or die "clankd: write PID file $pidfile: $!";
    print $pfh $$, "\n";
    close $pfh;
}

unlink $socket_path if $socket_path && -e $socket_path;   # stale socket from a crashed run

sub cleanup {
    unlink $socket_path if $socket_path && -e $socket_path;
    unlink $pidfile if $o{daemon} && -e $pidfile;
    $driver->close;
}
my $SHUTTING_DOWN = 0;   # set by handle_request on the shutdown command
$SIG{TERM} = $SIG{INT} = sub { cleanup(); exit 0 };

# --- request dispatch ---------------------------------------------------------
# Returns ($line, $exit_after): the response line to write (possibly empty for
# blank input) and whether the process must exit right after writing it.
# Never dies: protocol errors come back as ok=0 JSON.

sub handle_request {
    my ($raw) = @_;
    chomp $raw;
    return ('', 0) unless length $raw;

    my $msg  = eval { jdecode($raw) };
    my $resp;
    if ($@ || ref $msg ne 'HASH') {
        $resp = { ok => 0, error => 'invalid JSON' };
    } else {
        my $cmd = $msg->{command} // ($msg->{prompt} ? 'prompt' : undef);

        if (!defined $cmd) {
            $resp = { id => $msg->{id}, ok => 0, error => 'unknown or missing command' };
        } elsif ($cmd eq 'ping') {
            $resp = { id => $msg->{id}, ok => 1, pong => 1 };
        } elsif ($cmd eq 'prompt' || $cmd eq 'input') {
            my $text = $msg->{prompt} // $msg->{input};
            if (!defined $text || !length($text)) {
                $resp = { id => $msg->{id}, ok => 0, error => 'no prompt text' };
            } else {
                # Sigil dispatch first, then fall through to LLM.
                my $sigil_result = $sigil->dispatch($text);
                if ($sigil_result) {
                    $resp = { id => $msg->{id}, ok => 1, %$sigil_result };
                } else {
                    # No sigil: send to LLM (same as bare text in bin/clank).
                    my %ask;
                    $ask{timeout} = $msg->{timeout} // $o{timeout} if defined ($msg->{timeout} // $o{timeout});
                    $resp = $driver->ask($text, %ask);
                    $resp->{id} = $msg->{id};
                }
            }
        } elsif ($cmd eq 'session_info') {
            my $info = eval { $driver->info() };
            $resp = $@ ? { id => $msg->{id}, ok => 0, error => "$@" } : { id => $msg->{id}, %$info };
        } elsif ($cmd eq 'events') {
            # driver->events returns an ARRAYREF — assigning it to a list would
            # wrap it as one element ([[]]) instead of dereferencing.
            my $evs = eval { $driver->events(topic => $msg->{topic}, limit => $msg->{limit} // 200) };
            $resp = $@ ? { id => $msg->{id}, ok => 0, error => "$@" } : { id => $msg->{id}, ok => 1, events => $evs };
        } elsif ($cmd eq 'tools') {
            my @wits    = eval { $driver->wit_names };
            my $skipped = eval { $driver->skipped_wits };
            $resp = {
                id => $msg->{id}, ok => 1,
                tools   => [ sort $driver->tool_names ],
                wits    => \@wits,
                skipped => (ref($skipped) eq 'ARRAY') ? $skipped : [],
            };
        } elsif ($cmd eq 'session.send') {
            my $to = $msg->{to};
            my $payload = $msg->{payload} // {};
            if (!defined $to || !length $to) {
                $resp = { id => $msg->{id}, ok => 0, error => 'session.send requires "to" session id' };
            } else {
                my $mesh = $driver->mesh;
                if (!$mesh) {
                    $resp = { id => $msg->{id}, ok => 0, error => 'mesh not available' };
                } else {
                    my $result = $mesh->send($to, $payload);
                    $resp = { id => $msg->{id}, %$result };
                }
            }
        } elsif ($cmd eq 'session.broadcast') {
            my $payload = $msg->{payload} // {};
            my $mesh = $driver->mesh;
            if (!$mesh) {
                $resp = { id => $msg->{id}, ok => 0, error => 'mesh not available' };
            } else {
                my $result = $mesh->broadcast($payload);
                $resp = { id => $msg->{id}, %$result };
            }
        } elsif ($cmd eq 'session.messages') {
            my $mesh = $driver->mesh;
            if (!$mesh) {
                $resp = { id => $msg->{id}, ok => 0, error => 'mesh not available' };
            } else {
                my $messages = $mesh->query_messages(
                    from => $msg->{from},
                    limit => $msg->{limit} // 50,
                );
                $resp = { id => $msg->{id}, ok => 1, messages => $messages };
            }
        } elsif ($cmd eq 'status') {
            $resp = {
                id         => $msg->{id},
                ok         => 1,
                pid        => $$,
                session_id => $driver->session_id,
                daemon     => $o{daemon} ? 1 : 0,
            };
        } elsif ($cmd eq 'restart') {
            my $old_sid = eval { $driver->session_id };
            my $fresh   = $msg->{fresh} ? 1 : 0;
            eval { $driver->close };
            if ($@ && !$fresh && defined $old_sid) {
                # close failed but we can try to start anyway
            }
            eval {
                _init_driver($fresh ? () : (resume => $old_sid));
            };
            if ($@) {
                $resp = { id => $msg->{id}, ok => 0, error => "restart failed: $@" };
            } else {
                $resp = {
                    id         => $msg->{id},
                    ok         => 1,
                    session_id => $driver->session_id,
                    resumed    => $fresh ? 0 : 1,
                };
            }
        } elsif ($cmd eq 'shutdown') {
            print STDERR "clankd: shutdown requested\n";
            my $out = jencode({ id => $msg->{id}, ok => 1, bye => 1 }) . "\n";
            cleanup();
            $SHUTTING_DOWN = 1;
            return ($out, 1);   # the process must not survive its own goodbye
        } else {
            $resp = { id => $msg->{id}, ok => 0, error => "unknown command '$cmd'" };
        }
    }

    my $out = eval { jencode($resp) };
    if ($@) {   # a non-serializable value must not kill the loop
        $out = jencode({ id => (ref $msg eq 'HASH' ? $msg->{id} : undef), ok => 0, error => 'internal: result not JSON-serializable' });
    }
    return ($out . "\n", 0);
}

# --- sigil handlers for clankd ------------------------------------------------
# Same sigils as the REPL, adapted for JSON protocol output.

sub _register_clankd_sigils {
    my ($sigil, $driver) = @_;

    # / — Command: delegate to wit-registered commands.
    $sigil->register('/', sub {
        my ($app, $args) = @_;
        my ($name, $rest) = $args =~ /^(\S+)(?:\s+(.*))?$/;
        return { output => "usage: /<command> [args]" } unless defined $name;
        my %cmds = eval { %{ $driver->app->pm->all_commands } };
        return { output => "unknown command: /$name" } unless exists $cmds{$name};
        my $cmd = $cmds{$name};
        my $res = eval {
            $cmd->{handler}->({
                bus     => $driver->app->bus,
                store   => $driver->app->store,
                session => $driver->app->session,
                app     => $driver->app,
            }, $rest // '');
        };
        if ($@) { return { output => "command /$name failed: $@" } }
        if (ref $res eq 'HASH') { return $res }
        return { output => defined $res ? "$res" : undef };
    });

    # # — Comment: no-op.
    $sigil->register('#', sub { { output => '' } });

    # ? — Query: informational LLM query.
    $sigil->register('?', sub {
        my ($app, $args) = @_;
        return { output => 'usage: ? <question>' } unless length $args;
        my $wrapped = "[Informational query — answer from your knowledge of Clank. "
                    . "Do not use tools unless explicitly asked.]\n\n$args";
        my $resp = eval { $driver->ask($wrapped) };
        if ($@) { return { output => "query error: $@" } }
        return { output => $resp->{response} // '(no response)' };
    });

    # $ — Eval: Perl expression in harness context.
    $sigil->register('$', sub {
        my ($app, $args) = @_;
        return { output => 'usage: $ <perl expression>' } unless length $args;
        my $store   = $driver->app->store;
        my $bus     = $driver->app->bus;
        my $session = $driver->app->session;
        my $result  = eval "no warnings; $args";
        if ($@) { return { output => "eval error: $@" } }
        return { output => defined $result ? "$result" : '(undef)' };
    });

    # @ — Agent: dispatch agent operations.
    $sigil->register('@', sub {
        my ($app, $args) = @_;
        require Clank::Agent;
        my ($sub, $rest) = $args =~ /^(\S+)(?:\s+(.*))?$/;
        $sub //= '';

        if ($sub eq 'list' || $sub eq '') {
            my @names = Clank::Agent->list;
            return { output => 'usage: @list | @status | @<name> <prompt>' } unless @names;
            my @out;
            for my $name (@names) {
                my $p = Clank::Agent->load($name);
                push @out, sprintf("  %-16s %s", $p->{name}, $p->{description} // '');
            }
            return { output => "agents:\n" . join("\n", @out) };
        }

        if ($sub eq 'status') {
            my $stats = Clank::Agent->stats;
            my @out;
            for my $name (sort keys %$stats) {
                my $s = $stats->{$name};
                push @out, sprintf("  %-16s calls:%d ok:%d errors:%d turns:%d",
                    $name, $s->{calls}, $s->{ok}, $s->{errors}, $s->{turns});
            }
            return { output => @out ? "agent stats:\n" . join("\n", @out) : '(no agents invoked yet)' };
        }

        my $prompt = $rest // '';
        return { output => "usage: @<agent-name> <prompt>" } unless length $prompt;
        my $loop = $driver->app->loop;
        return { output => 'no active loop — start a session first' } unless $loop;
        my $result = eval {
            Clank::Agent->spawn(name => $sub, prompt => $prompt, loop => $loop);
        };
        if ($@) { return { output => "agent error: $@" } }
        my $out = "[$result->{agent}] turns: $result->{turns}\n\n" . ($result->{output} // '(no output)');
        return { output => $out };
    });

    # % — Pipeline: run named pipeline.
    $sigil->register('%', sub {
        my ($app, $args) = @_;
        require Clank::Pipeline;
        return { output => 'usage: % <pipeline-name> | % list' } unless length $args;
        if ($args eq 'list') {
            my @names = Clank::Pipeline->list;
            return { output => '(no pipelines found)' } unless @names;
            return { output => "pipelines:\n  " . join("\n  ", @names) };
        }
        my $pipeline = Clank::Pipeline->load($args);
        return { output => "pipeline '$args' not found" } unless $pipeline;
        my $result = eval { Clank::Pipeline->run($pipeline, app => $driver->app) };
        if ($@) { return { output => "pipeline error: $@" } }
        return { output => $result->{output} // '(no output)' };
    });

    # > — Pipe: inline pipeline construction.
    $sigil->register('>', sub {
        my ($app, $args) = @_;
        require Clank::Pipeline;
        return { output => 'usage: > stage1 | stage2 | stage3' } unless length $args;
        my $result = eval { Clank::Pipeline->run_inline($args, app => $driver->app) };
        if ($@) { return { output => "pipe error: $@" } }
        unless ($result->{ok}) { return { output => $result->{error} } }
        return { output => $result->{output} // '(no output)' };
    });

    # : — Topic: bus publish/subscribe.
    $sigil->register(':', sub {
        my ($app, $args) = @_;
        return { output => 'usage: : <topic> | : listen <topic> | : publish <topic> <json>' } unless length $args;
        my $bus = $driver->app->bus;

        if ($args =~ /^listen\s+(\S+)/) {
            my $topic = $1;
            my @seen;
            my $sub_id = $bus->subscribe($topic, sub {
                push @seen, $_[0]{payload} if @seen < 10;
            }, name => 'sigil_listen');
            select(undef, undef, undef, 0.1);
            $bus->unsubscribe($sub_id);
            if (@seen) {
                require Clank::Util;
                my @out = map { '  ' . Clank::Util::jencode($_) } @seen;
                return { output => "events on $topic:\n" . join("\n", @out) };
            }
            return { output => "(no recent events on $topic)" };
        }

        if ($args =~ /^publish\s+(\S+)\s+(.+)$/) {
            my ($topic, $payload_str) = ($1, $2);
            my $payload = eval { Clank::Util::jdecode($payload_str) };
            if ($@) { return { output => "invalid JSON: $@" } }
            $bus->publish($topic, $payload);
            return { output => "published to $topic" };
        }

        $bus->publish($args, {});
        return { output => "published to $args" };
    });

    # ~ — Wit: wit lifecycle management.
    $sigil->register('~', sub {
        my ($app, $args) = @_;
        my ($sub, $rest) = $args =~ /^(\S+)(?:\s+(.*))?$/;
        $sub //= '';
        my $pm = $driver->app->pm;

        if ($sub eq 'list' || $sub eq '') {
            my @ws = $driver->app->wits;
            return { output => '(no wits loaded)' } unless @ws;
            my @out;
            for my $w (@ws) {
                push @out, sprintf("  %-20s %-9s %s", $w->{name}, $w->{state} // 'active', $w->{dir});
            }
            return { output => "wits:\n" . join("\n", @out) };
        }

        if ($sub eq 'load') {
            return { output => 'usage: ~ load <directory-path>' } unless defined $rest && length $rest;
            my @loaded = eval { $pm->load_all(extra_paths => [$rest]) };
            if ($@) { return { output => "load error: $@" } }
            return { output => "loaded " . scalar(@loaded) . " wit(s) from $rest" };
        }

        if ($sub eq 'unload') {
            return { output => 'usage: ~ unload <wit-name>' } unless defined $rest && length $rest;
            my $result = eval { $pm->disable_wit($rest) };
            if ($@) { return { output => "unload error: $@" } }
            return { output => $result };
        }

        if ($sub eq 'inspect') {
            return { output => 'usage: ~ inspect <wit-name>' } unless defined $rest && length $rest;
            my @ws = $driver->app->wits;
            for my $w (@ws) {
                if ($w->{name} eq $rest) {
                    my @out = ("$rest:");
                    push @out, "  state: " . ($w->{state} // 'active');
                    push @out, "  dir:   $w->{dir}";
                    push @out, "  pkg:   $w->{pkg}";
                    return { output => join("\n", @out) };
                }
            }
            return { output => "wit '$rest' not found" };
        }

        if ($sub eq 'status') {
            my @ws = $driver->app->wits;
            my $active = grep { !($_->{state} // '') eq 'disabled' } @ws;
            return { output => "wits: $active active, " . scalar(@ws) . " total" };
        }

        return { output => "usage: ~ list | ~ load <path> | ~ unload <name> | ~ inspect <name> | ~ status" };
    });

    # ! — History: not applicable in stateless JSON protocol.
    $sigil->register('!', sub {
        my ($app, $args) = @_;
        return { output => "history not available in clankd — send the command directly" };
    });
}

# --- transports ----------------------------------------------------------------

if ($socket_path) {
    my $server = IO::Socket::UNIX->new(
        Local => $socket_path, Type => SOCK_STREAM, Listen => 5,
    ) or do { print STDERR "clankd: cannot create socket $socket_path: $!\n"; exit 1 };
    chmod 0600, $socket_path;
    print STDERR "clankd: listening on $socket_path (session ", $driver->session_id, ")\n";

    my $select = IO::Select->new($server);
    my %buffers;
    while (!$SHUTTING_DOWN && (my @ready = $select->can_read)) {
        for my $fh (@ready) {
            if ($fh == $server) {
                my $client = $server->accept or next;
                $client->autoflush(1);
                $select->add($client);
                $buffers{$client} = '';
            } else {
                my $n = sysread($fh, my $data, 65536);
                if ($n) {
                    $buffers{$fh} .= $data;
                    while ($buffers{$fh} =~ s/^(.*\n)//) {
                        my ($out, $exit_after) = handle_request($1);
                        print {$fh} $out if length $out;
                        last if $exit_after;
                    }
                } else {
                    $select->remove($fh);
                    delete $buffers{$fh};
                    $fh->close;
                }
            }
        }
    }
    cleanup();
} else {
    # stdio: the parent's pipe IS the lifecycle.  EOF (parent closed or died)
    # exits cleanly — this is what prevents zombie daemons.
    print STDERR "clankd: stdio transport (session ", $driver->session_id, ")\n";
    while (defined(my $line = <STDIN>)) {
        my ($out, $exit_after) = handle_request($line);
        print STDOUT $out if length $out;
        last if $exit_after;
    }
    cleanup();
}

exit 0;
