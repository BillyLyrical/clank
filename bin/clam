#!/usr/bin/env perl
# clam — AI coding harness (Perl port of Pi). Entry point.
use strict;
use warnings;
use FindBin;
use lib "$FindBin::RealBin/../lib";
use Getopt::Long qw(GetOptions);
use File::Path qw(make_path remove_tree);

my %opt = ();
my @wit_paths;   # repeatable -w/--wit: collect in a real array (avoids Getopt warning)
GetOptions(
    'provider=s' => \$opt{provider},
    "model=s"    => \$opt{model},
    'base-url=s' => \$opt{base_url},
    'api-key=s'  => \$opt{api_key},
    'db=s'       => \$opt{db},
    'wit|w+'     => \@wit_paths,
    'resume=s'   => \$opt{resume},
    'stream'     => \$opt{stream},
    'help|h'     => \$opt{help},
) or exit _usage(2);
$opt{wit_paths} = \@wit_paths if @wit_paths;

my @argv = @ARGV;

if (@argv && $argv[0] eq 'wits') {
    shift @argv;
    exit(_cmd_wits(@argv) ? 0 : 1);
}
if (@argv && $argv[0] eq 'providers') {
    shift @argv;
    exit(_cmd_providers(\%opt, @argv) ? 0 : 1);
}
exit _usage(0) if $opt{help} && !@argv;   # must exit — otherwise App is still constructed below

# One-shot prompt or interactive REPL.
require Clam::App;
my $app = Clam::App->new(%opt);
if (@argv) {
    my $prompt = join(' ', @argv);
    $app->start_session(resume => $opt{resume});
    $app->bus->subscribe('tool_execution_start', sub {
        printf "[tool] %s\n", $_[0]{payload}{name};
    }, name => 'oneshot.tools');
    my $result = eval { $app->run_prompt($prompt) };
    if ($@) { print "error: $@\n"; exit 1 }
    unless ($result->{ok}) { print "agent error: $result->{error}\n"; exit 1 }
    my $leaf = $app->store->get_message($app->store->leaf_message($app->session->id));
    if ($leaf && (($leaf->{role} // '') eq 'assistant') && ref $leaf->{content} eq 'HASH') {
        print $leaf->{content}{text}, "\n" if length($leaf->{content}{text} // '');
    }
} else {
    require Clam::REPL;
    Clam::REPL->new(%opt)->run();
}
$app->shutdown;

# ---------------------------------------------------------------------------
sub _usage {
    my ($code) = @_;
    print <<'EOF';
clam — AI coding harness (Perl port of Pi)

usage: clam [options] [prompt...]
       clam wits install|list|uninstall|info <name>
       clam providers [test]

options:
  --provider NAME     lmstudio | openai-compat   (env CLAM_PROVIDER)
  --model NAME        model id                   (env CLAM_MODEL)
  --base-url URL      OpenAI-compatible endpoint (env CLAM_BASE_URL)
  --api-key KEY       API key (env CLAM_API_KEY; never persisted to db/logs)
  --db PATH           SQLite db path             (default ~/.clam/clam.db)
  -w, --wit DIR       extra wit directory        (repeatable; env CLAM_WITS_PATH)
  --resume ID         resume a session
  --stream            stream tokens to stdout
  -h, --help          this help

With no prompt: interactive REPL. With a prompt: one-shot run.
EOF
    return $code // 0;
}

# --- wits subcommand --------------------------------------------------------
sub _wits_roots {
    my @roots;
    push @roots, split /:/, $ENV{CLAM_WITS_PATH} if defined $ENV{CLAM_WITS_PATH} && length $ENV{CLAM_WITS_PATH};
    push @roots, '.clam/wits';
    push @roots, "$ENV{HOME}/.clam/wits" if defined $ENV{HOME};
    return grep { length } @roots;
}

sub _cmd_wits {
    my ($action, @args) = @_;
    $action //= 'list';

    if ($action eq 'install') {
        my $src = shift @args or die "usage: clam wits install <dir>\n";
        -d $src or die "not a directory: $src\n";
        (my $name = $src) =~ s{.*/}{};

        # Deck awareness: validate the manifest against the files present.
        if (-f "$src/deck.toml") {
            require Clam::WitFile;
            require Clam::WitLoader;
            open my $fh, '<', "$src/deck.toml" or die "cannot read deck.toml: $!\n";
            my $c = do { local $/; <$fh> }; close $fh;
            my $d = eval { Clam::WitFile::parse_toml($c) };
            if ($@) {
                warn "warning: unparseable deck.toml in $src: $@";
            } else {
                print "deck: ", ($d->{name} // $name), " — ", ($d->{description} // ''), "\n";
                my %have = map { $_ => 1 } @{ Clam::WitLoader->list_wits($src) };
                for my $w (@{ $d->{wits} // [] }) {
                    warn "warning: deck lists missing wit: $w\n" unless $have{$w};
                }
            }
        }

        my $dest_dir = "$ENV{HOME}/.clam/wits";
        make_path($dest_dir);
        my $dest = "$dest_dir/$name";
        die "already installed: $dest\n" if -d $dest;
        _copy_tree($src, $dest);
        print "installed ", (-f "$src/deck.toml" ? "deck" : "wit"), " '$name' -> $dest\n";
        return 1;
    }

    if ($action eq 'uninstall') {
        my $name = shift @args or die "usage: clam wits uninstall <name>\n";
        my $dir  = "$ENV{HOME}/.clam/wits/$name";
        -d $dir or die "not installed: $name\n";
        remove_tree($dir);
        print "uninstalled '$name'\n";
        return 1;
    }

    if ($action eq 'info') {
        my $name = shift @args or die "usage: clam wits info <name>\n";
        my $found = 0;
        for my $root (_wits_roots()) {
            my $d = "$root/$name";
            next unless -d $d;
            $found = 1;
            print "$name:\n  dir: $d\n";
            if (-f "$d/README.md") {
                open my $fh, '<', "$d/README.md" or next;
                my $first = <$fh>; close $fh;
                chomp $first;
                print "  ", $first, "\n" if length $first;
            }
        }
        die "wit not found: $name\n" unless $found;
        return 1;
    }

    # list (default)
    my $any = 0;
    for my $root (_wits_roots()) {
        next unless -d $root;
        opendir(my $dh, $root) or next;
        my @entries = sort grep { !/^\./ && -d "$root/$_" } readdir($dh);
        closedir $dh;
        next unless @entries;
        print "$root:\n";
        printf "  %-20s %s\n", $_, _describe_wit_dir("$root/$_") for @entries;
        $any = 1;
    }
    print "(no wits found)\n" unless $any;
    return 1;
}

sub _describe_wit_dir {
    my ($d) = @_;
    require Clam::WitLoader;
    my @wits = @{ Clam::WitLoader->list_wits($d) };
    if (@wits) {
        return (-f "$d/deck.toml" ? "deck (" . scalar(@wits) . " wits)" : "declarative (" . scalar(@wits) . " wits)");
    }
    return -d "$d/lib" ? 'lib layout' : 'single-file';
}

sub _copy_tree {
    my ($src, $dest) = @_;
    make_path($dest);
    opendir(my $dh, $src) or die "opendir $src: $!";
    for my $e (readdir $dh) {
        next if $e =~ /^\.\.?$/;
        my ($s, $d) = ("$src/$e", "$dest/$e");
        if (-d $s) { _copy_tree($s, $d); }
        else {
            require File::Copy;
            File::Copy::copy($s, $d) or die "copy $s -> $d: $!";
        }
    }
    closedir $dh;
}

# --- providers subcommand ---------------------------------------------------
sub _cmd_providers {
    my ($opt, @args) = @_;
    require Clam::Providers;
    my %p = (
        name     => $opt->{provider},
        model    => $opt->{model},
        base_url => $opt->{base_url},
        api_key  => $opt->{api_key},
    );

    if (($args[0] // '') eq 'test') {
        my $prov = Clam::Providers->create(%p);
        print "probing ", $prov->log_safe, "\n";
        my @ids = eval { @{ Clam::Providers::probe_models($prov) } };
        if ($@) { print "FAIL: $@"; return 0 }
        if (@ids) { print "models: ", join(', ', @ids), "\n" }
        else      { print "(connected, no models reported)\n" }
        return 1;
    }

    my $active = Clam::Providers->create(%p);
    print "active: ", $active->log_safe, "\n";
    print "known providers: ", join(', ', Clam::Providers::known()), "\n";
    return 1;
}
