{
  "name": "Clank-Wits-Db",
  "version": "1.0.0",
  "author": "Clank",
  "license": "Artistic-2.0",
  "abstract": "Database wits for Clank — connect, query, execute, schema, shell, history, export, import",
  "provides": {
    "Clank::Wits::Db::Connect": {
      "file": "lib/Clank/Wits/Db/Connect.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::Query": {
      "file": "lib/Clank/Wits/Db/Query.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::Execute": {
      "file": "lib/Clank/Wits/Db/Execute.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::Schema": {
      "file": "lib/Clank/Wits/Db/Schema.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::Shell": {
      "file": "lib/Clank/Wits/Db/Shell.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::History": {
      "file": "lib/Clank/Wits/Db/History.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::Export": {
      "file": "lib/Clank/Wits/Db/Export.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Db::Import": {
      "file": "lib/Clank/Wits/Db/Import.pm",
      "version": "1.0.0"
    }
  },
  "requires": {
    "perl": "5.010"
  },
  "wits": [
    { "trigger": "db_connect",       "module": "Clank::Wits::Db::Connect" },
    { "trigger": "db_query",         "module": "Clank::Wits::Db::Query" },
    { "trigger": "db_execute",       "module": "Clank::Wits::Db::Execute" },
    { "trigger": "db_schema",        "module": "Clank::Wits::Db::Schema" },
    { "trigger": "db_shell",         "module": "Clank::Wits::Db::Shell" },
    { "trigger": "dbshell_history",  "module": "Clank::Wits::Db::History" },
    { "trigger": "dbshell_export",   "module": "Clank::Wits::Db::Export" },
    { "trigger": "dbshell_import",   "module": "Clank::Wits::Db::Import" }
  ]
}
