{
  "name": "Clank-Wits-Devops",
  "version": "1.0.0",
  "author": "Clank",
  "license": "Artistic-2.0",
  "abstract": "DevOps wits for Clank — Docker, systemd, service management",
  "provides": {
    "Clank::Wits::Devops::DockerPs": {
      "file": "lib/Clank/Wits/Devops/DockerPs.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Devops::DockerRun": {
      "file": "lib/Clank/Wits/Devops/DockerRun.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Devops::DockerLogs": {
      "file": "lib/Clank/Wits/Devops/DockerLogs.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Devops::SystemdStatus": {
      "file": "lib/Clank/Wits/Devops/SystemdStatus.pm",
      "version": "1.0.0"
    }
  },
  "requires": {
    "perl": "5.010"
  },
  "wits": [
    { "trigger": "docker_ps",        "module": "Clank::Wits::Devops::DockerPs" },
    { "trigger": "docker_run",       "module": "Clank::Wits::Devops::DockerRun" },
    { "trigger": "docker_logs",      "module": "Clank::Wits::Devops::DockerLogs" },
    { "trigger": "systemd_status",   "module": "Clank::Wits::Devops::SystemdStatus" }
  ]
}
