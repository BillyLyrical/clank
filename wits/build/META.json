{
  "name": "Clank-Wits-Build",
  "version": "1.0.0",
  "author": "Clank",
  "license": "Artistic-2.0",
  "abstract": "Build system wits for Clank — make, perl build, cpanm, test, terminal ops",
  "provides": {
    "Clank::Wits::Build::Make": {
      "file": "lib/Clank/Wits/Build/Make.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::PerlBuild": {
      "file": "lib/Clank/Wits/Build/PerlBuild.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::Cpanm": {
      "file": "lib/Clank/Wits/Build/Cpanm.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::Test": {
      "file": "lib/Clank/Wits/Build/Test.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::ProductionAudit": {
      "file": "lib/Clank/Wits/Build/ProductionAudit.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::VerificationLoop": {
      "file": "lib/Clank/Wits/Build/VerificationLoop.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::GateGuard": {
      "file": "lib/Clank/Wits/Build/GateGuard.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::Council": {
      "file": "lib/Clank/Wits/Build/Council.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::SkillComply": {
      "file": "lib/Clank/Wits/Build/SkillComply.pm",
      "version": "1.0.0"
    }
  },
  "requires": {
    "perl": "5.010"
  },
  "wits": [
    { "trigger": "build_make",              "module": "Clank::Wits::Build::Make" },
    { "trigger": "build_perl_build",        "module": "Clank::Wits::Build::PerlBuild" },
    { "trigger": "build_cpanm",             "module": "Clank::Wits::Build::Cpanm" },
    { "trigger": "build_test",              "module": "Clank::Wits::Build::Test" },
    { "trigger": "build_production_audit",  "module": "Clank::Wits::Build::ProductionAudit" },
    { "trigger": "build_verification_loop", "module": "Clank::Wits::Build::VerificationLoop" },
    { "trigger": "build_gateguard",          "module": "Clank::Wits::Build::GateGuard" },
    { "trigger": "build_council",            "module": "Clank::Wits::Build::Council" },
    { "trigger": "build_skill_comply",       "module": "Clank::Wits::Build::SkillComply" }
  ]
}
