{
  "name": "Clank-Wits-Build",
  "version": "1.0.0",
  "author": "Clank",
  "license": "Artistic-2.0",
  "abstract": "Build system wits for Clank — make, perl build, cpanm, test",
  "provides": {
    "Clank::Wits::Build::Make": {
      "file": "lib/Clank/Wits/Build/Make.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::PerlBuild": {
      "file": "lib/Clank/Wits/Build/PerlBuild.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::Cpanm": {
      "file": "lib/Clank/Wits/Build/Cpanm.pm",
      "version": "1.0.0"
    },
    "Clank::Wits::Build::Test": {
      "file": "lib/Clank/Wits/Build/Test.pm",
      "version": "1.0.0"
    }
  },
  "requires": {
    "perl": "5.010"
  },
  "wits": [
    { "trigger": "build_make",       "module": "Clank::Wits::Build::Make" },
    { "trigger": "build_perl_build", "module": "Clank::Wits::Build::PerlBuild" },
    { "trigger": "build_cpanm",      "module": "Clank::Wits::Build::Cpanm" },
    { "trigger": "build_test",       "module": "Clank::Wits::Build::Test" }
  ]
}
